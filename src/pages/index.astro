---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Transposer from "../components/Transposer.astro";
import BaseChords from "../components/BaseChords.astro";
import ProgressionCatalog from "../components/ProgressionCatalog.astro";
import Inversions from "../components/Inversions.astro";
import Exercise from "../components/Exercise.astro";
import Emotions from "../components/Emotions.astro";
import Tips from "../components/Tips.astro";
import SynthLab from "../components/SynthLab.astro";
import FxLab from "../components/FxLab.astro";
import Fretboard from "../components/Fretboard.astro";
import Beats from "../components/Beats.astro";
import ChordsByKey from "../components/ChordsByKey.astro";
import CircleOfFifths from "../components/CircleOfFifths.astro";
import { SITE_NAME, SITE_SUBTITLE } from "../data/site";
import Logo from "../components/Logo.astro";
import Afinador from "../components/Afinador.astro";
import QuickListen from "../components/QuickListen.astro";
import MelodyKeyboard from "../components/MelodyKeyboard.astro";
import LabPracticeKeyboard from "../components/LabPracticeKeyboard.astro";
import SoundPropertiesExplorer from "../components/SoundPropertiesExplorer.astro";
import IntervalExplorer from "../components/IntervalExplorer.astro";
import InteractiveIntervalTable from "../components/InteractiveIntervalTable.astro";
import EmptyStaff from "../components/EmptyStaff.astro";
import ScaleTable from "../components/ScaleTable.astro";
import NoteNameKeyboard from "../components/NoteNameKeyboard.astro";

const extraSymbols = ["♬", "♭", "♯", "𝄞", "♪"];
const extraNotes = extraSymbols.map((sym, i) => {
  const r = Math.random();
  const color = r < 0.5 ? "note-red" : "note-green";
  const angle = Math.round((360 / extraSymbols.length) * i);
  const duration = 14 + (i % 5) * 4;
  const delay = -(i * 1.7).toFixed(1);
  const size = (1.3 + (i % 3) * 0.35).toFixed(2);
  return { sym, color, angle, duration, delay, size, i };
});
---
<Layout>
 <section class="product-hero" aria-labelledby="product-title">
  <div class="hero-copy">
   <span class="hero-eyebrow">PROGRESSIVE MUSIC · APRENDE A TU RITMO</span>
   <h1 id="product-title">
  {SITE_NAME}
  <Logo class="h1-logo" />
   </h1>
   <h2 class="subtitle">{SITE_SUBTITLE}</h2>
   <p class="lead">
  No necesitas saber teoría ni haber tocado antes: empieza por escuchar, mira
  qué notas forman cada sonido y prueba a tocarlas. Avanza a tu ritmo en piano
  y guitarra, desde los primeros acordes hasta crear tus propias ideas.
   </p>
   <a class="hero-cta" href="#m1">Empieza a explorar <span aria-hidden="true">↓</span></a>
  </div>
  <div class="hero-art" aria-hidden="true">
    <span class="hero-orbit orbit-one"></span><span class="hero-orbit orbit-two"></span>
    <div class="hero-glow"></div>
    <div class="hero-note note-one">♪</div><div class="hero-note note-two">♫</div><div class="hero-note note-three">♩</div>
    {extraNotes.map((n) => (
      <div class="hero-note-orbit">
        <div class="hero-note-runner" style={`--angle:${n.angle}deg;--duration:${n.duration}s;--delay:${n.delay}s;`}>
          <span class:list={["hero-note", "hero-note-margin", n.color]} style={`--size:${n.size}rem;--angle:${n.angle}deg;--duration:${n.duration}s;--delay:${n.delay}s;`}>{n.sym}</span>
        </div>
      </div>
    ))}
  </div>
 </section>
 <fieldset class="theme-picker" aria-label="Elegir tema">
  <legend>Elegir tema</legend>
  <label><input type="radio" name="theme" value="dark" checked /> Oscuro</label>
  <label><input type="radio" name="theme" value="light" /> Claro</label>
 </fieldset>
 <label class="glossary-switch">
  <input type="checkbox" id="glossary-toggle" />
  Mostrar glosario emergente al pulsar términos
 </label>
 <aside class="learning-route" aria-label="Método de aprendizaje recomendado">
  <b>Una forma fácil de aprender</b>
  <ol>
   <li>
    <b>Escucha:</b> reconoce si el sonido descansa, avanza o crea tensión.
   </li>
   <li>
    <b>Mira:</b> observa qué notas suenan en el teclado o en los trastes.
   </li>
   <li><b>Prueba:</b> cambia una nota o un acorde y vuelve a escuchar.</li>
   <li><b>Recuerda:</b> explica con tus palabras qué cambió y por qué.</li>
  </ol>
 </aside>
 <div class="keyboard-showcase"><div class="showcase-label"><span>PRUEBA EL SONIDO</span><span>Una nota basta para empezar</span></div><MelodyKeyboard /></div>

 <section id="progress-panel" class="box" aria-labelledby="progress-panel-title">
  <h3 id="progress-panel-title">Mi progreso</h3>
  <p>Nivel: <strong id="progress-level">Aprendiz</strong></p>
  <div style="height:8px;background:var(--bd);border-radius:999px;overflow:hidden;margin:8px 0;">
   <div id="progress-bar-fill" style="height:100%;width:0;background:var(--acc);border-radius:inherit;"></div>
  </div>
  <p id="progress-xp">0 XP</p>
  <p>Insignias: <span id="progress-badges">—</span></p>
  <p>Módulos completados: <span id="progress-modules">0</span></p>
  <label style="display:inline-flex;align-items:center;gap:8px;margin:8px 0;font-weight:700;">
   <input type="checkbox" id="sound-toggle" /> Sonido de acierto
  </label>
  <button type="button" id="reset-progress">Reiniciar progreso</button>
 </section>

 <nav class="module-index" id="module-nav" aria-label="Índice de módulos">
