  <div id="glossary-modal" class="glossary-modal" hidden>
    <div class="glossary-modal-card" role="dialog" aria-modal="true" aria-labelledby="glossary-modal-title">
      <button type="button" class="glossary-modal-close" data-close-glossary aria-label="Cerrar">×</button>
      <h3 id="glossary-modal-title"></h3>
      <p id="glossary-modal-def"></p>
      <small id="glossary-modal-meta"></small>
    </div>
  </div>

  <style>
    .module-index { margin: 24px 0; padding: 16px; border: 1px solid var(--bd); border-radius: 18px; background: var(--card); }
    .progress-summary { margin: 0 0 10px; color: var(--mut); font-weight: 700; font-size: 0.85rem; }
    .module-index a.is-active { color: var(--acc); font-weight: 800; }
    .module-index ol { columns: 2; column-gap: 24px; }
    @media (max-width: 640px) { .module-index ol { columns: 1; } }
    .module { margin: 28px 0; padding: 20px; border: 1px solid var(--bd); border-radius: 20px; background: var(--card); }
    .module h2 { margin-top: 0; }
    .lesson-summary { color: var(--mut); }
    .progress-toggle { display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; font-weight: 700; }
    .term {
      text-decoration: underline dotted;
      cursor: help;
      position: relative;
      font-weight: 700;
      background: linear-gradient(90deg, #e11d48, #f97316, #eab308, #22c55e, #0ea5e9, #6366f1, #a855f7);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    body.glossary-disabled .term:hover::after,
    body.glossary-disabled .term:focus::after { display: none !important; }
    .term:hover::after, .term:focus::after {
      content: attr(data-tip);
      position: absolute; left: 0; top: 1.4em; z-index: 10;
      background: var(--bg); border: 1px solid var(--bd); border-radius: 10px;
      padding: 6px 10px; font-size: 0.8rem; white-space: normal; width: 220px;
      box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
    }
    .glossary-list { margin-top: 12px; display: grid; gap: 8px; }
    .glossary-item { padding: 10px 12px; border: 1px solid var(--bd); border-radius: 12px; background: var(--bg); }
    .glossary-item b { display: block; }
    .glossary-item small { color: var(--mut); }
    .glossary-switch { display: inline-flex; align-items: center; gap: 8px; margin: 8px 0 16px; font-weight: 700; }
    .kid-note { margin: 8px 0 16px; padding: 10px 14px; border-radius: 12px; background: color-mix(in srgb, #a855f7 12%, var(--card)); border: 1px solid color-mix(in srgb, #a855f7 30%, var(--bd)); font-size: 0.9rem; }
    .glossary-modal { position: fixed; inset: 0; background: rgb(0 0 0 / 0.45); display: flex; align-items: center; justify-content: center; z-index: 100; }
    .glossary-modal[hidden] { display: none; }
    .glossary-modal-card { position: relative; max-width: 420px; width: 90%; background: var(--card); border: 1px solid var(--bd); border-radius: 18px; padding: 20px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.2); }
    .glossary-modal-close { position: absolute; top: 8px; right: 12px; border: none; background: transparent; font-size: 1.4rem; cursor: pointer; }
    .glossary-modal-card h3 { margin: 0 0 8px; }
    .glossary-modal-card small { color: var(--mut); }
  </style>

  <script>
    import { GLOSSARY } from '../data/glossary';
    import { readProgress, setModuleProgress } from '../lib/progress';

    // Tooltips accesibles por teclado
    document.querySelectorAll<HTMLElement>('.term').forEach((el) => {
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'button');
      el.setAttribute('aria-label', el.dataset.tip ?? '');
    });

    // Persistencia de progreso por módulo
    const toggles = Array.from(document.querySelectorAll<HTMLInputElement>('[data-module-toggle]'));
    const progress = readProgress();
    const summary = document.getElementById('progress-summary');
    function updateProgressSummary() {
      if (!summary) return;
      const done = toggles.filter((t) => t.checked).length;
      summary.textContent = `Progreso: ${done}/${toggles.length} módulos completados`;
    }
    toggles.forEach((toggle) => {
      const id = toggle.dataset.moduleToggle ?? '';
      toggle.checked = Boolean(progress[id]?.completed);
      toggle.addEventListener('change', () => {
        setModuleProgress(id, { completed: toggle.checked });
        updateProgressSummary();
      });
    });
    updateProgressSummary();

    // Resaltado del índice de módulos según scroll
    const moduleLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.module-index a'));
    const moduleSections = moduleLinks
      .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') ?? ''))
      .filter((s): s is HTMLElement => Boolean(s));
    const modObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        moduleLinks.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === '#' + visible.target.id));
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: [0.1, 0.4] },
    );
    moduleSections.forEach((s) => modObserver.observe(s));

    // Glosario emergente (modal) con interruptor
    const GLOSSARY_KEY = 'progressive-music:glossary-modals';
    const toggle = document.getElementById('glossary-toggle') as HTMLInputElement | null;
    let glossaryEnabled = true;
    try {
      const stored = window.localStorage.getItem(GLOSSARY_KEY);
      glossaryEnabled = stored === null ? true : stored === '1';
    } catch { /* ignore */ }
    function applyGlossaryState() {
      document.body.classList.toggle('glossary-disabled', !glossaryEnabled);
    }
    applyGlossaryState();
    if (toggle) {
      toggle.checked = glossaryEnabled;
      toggle.addEventListener('change', () => {
        glossaryEnabled = toggle.checked;
        applyGlossaryState();
        try { window.localStorage.setItem(GLOSSARY_KEY, glossaryEnabled ? '1' : '0'); } catch { /* ignore */ }
      });
    }

    const modal = document.getElementById('glossary-modal');
    const modalTitle = document.getElementById('glossary-modal-title');
    const modalDef = document.getElementById('glossary-modal-def');
    const modalMeta = document.getElementById('glossary-modal-meta');
    function openGlossary(term: string, tip: string) {
      if (!glossaryEnabled || !modal) return;
      const entry = GLOSSARY.find((e) => e.term.toLowerCase() === term.toLowerCase());
      if (modalTitle) modalTitle.textContent = entry?.term ?? term;
      if (modalDef) modalDef.textContent = entry?.definition ?? tip;
      if (modalMeta) modalMeta.textContent = entry ? `${entry.english ?? ''} · ${entry.category}${entry.commonError ? ' · Error común: ' + entry.commonError : ''}`.replace(/^ · /, '') : '';
      modal.hidden = false;
    }
    function closeGlossary() {
      if (modal) modal.hidden = true;
    }
    document.querySelector('[data-close-glossary]')?.addEventListener('click', closeGlossary);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeGlossary(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGlossary(); });

    document.querySelectorAll<HTMLElement>('.term').forEach((el) => {
      el.style.cursor = 'pointer';
      el.addEventListener('click', (ev) => {
        ev.preventDefault();
        openGlossary(el.textContent?.trim() ?? '', el.dataset.tip ?? '');
      });
    });
  </script>
