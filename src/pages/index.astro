  .contact-kicker { display: inline-flex; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--acc); margin-bottom: 6px; }
  .contact-module h2 { margin: 0 0 8px; }
  .contact-lead { margin: 0; color: var(--mut); font-size: 1rem; max-width: 62ch; }
  .contact-art { display: grid; place-items: center; min-height: 220px; }
  .coffee-svg { width: min(100%, 280px); height: auto; overflow: visible; filter: drop-shadow(0 18px 30px rgba(0,0,0,.18)); }
  .coffee-svg * { transform-box: fill-box; transform-origin: center; }
  .art-glow { fill: color-mix(in srgb, var(--acc) 18%, transparent); }
  .saucer { fill: color-mix(in srgb, var(--bd) 70%, #fff 30%); opacity: .9; }
  .mug { stroke: #f59e0b33; stroke-width: 2; }
  .coffee-shine { fill: #fff; opacity: .18; }
  .handle { fill: none; stroke: #f3d8a8; stroke-width: 12; stroke-linecap: round; }
  .eye { fill: #3b2414; }
  .smile { fill: none; stroke: #3b2414; stroke-width: 4; stroke-linecap: round; }
  .blush { fill: #fb7185; opacity: .35; }
  .steam-line { fill: none; stroke: #fff; stroke-opacity: .7; stroke-width: 5; stroke-linecap: round; }
  .floater text { font: 700 22px/1 system-ui, sans-serif; fill: url(#accentGrad); }

  .cup-wrap { transform-origin: 110px 150px; animation: cup-bob 4.8s ease-in-out infinite; }
  .steam-line.s1 { animation: steam-rise 3.2s ease-in-out infinite; }
  .steam-line.s2 { animation: steam-rise 3.8s ease-in-out infinite .6s; }
  .steam-line.s3 { animation: steam-rise 3.4s ease-in-out infinite 1.1s; }
  .floater.f1 { animation: float-note 5.2s ease-in-out infinite; }
  .floater.f2 { animation: float-note 4.6s ease-in-out infinite .8s; }
  .floater.f3 { animation: float-note 5.8s ease-in-out infinite 1.4s; }
  .face .eye { transform-origin: center; animation: blink 6s infinite; }
  .art-glow { transform-origin: 110px 118px; animation: pulse-glow 5s ease-in-out infinite; }

  @keyframes steam-rise {
    0% { opacity: 0; transform: translateY(8px) scale(.96); }
    30% { opacity: .75; }
    100% { opacity: 0; transform: translateY(-18px) scale(1.04); }
  }
  @keyframes cup-bob { 0%,100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-4px) rotate(1deg); } }
  @keyframes float-note { 0%,100% { transform: translateY(0); opacity: .85; } 50% { transform: translateY(-10px); opacity: 1; } }
  @keyframes blink { 0%, 46%, 50%, 100% { transform: scaleY(1); } 48% { transform: scaleY(.1); } }
  @keyframes pulse-glow { 0%,100% { transform: scale(1); opacity: .85; } 50% { transform: scale(1.04); opacity: 1; } }

  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; position: relative; z-index: 1; }
  .contact-card { position: relative; padding: 18px; border-radius: 20px; border: 1px solid var(--bd); background: linear-gradient(180deg, color-mix(in srgb, var(--card) 92%, #fff 8%), var(--card)); box-shadow: 0 10px 28px rgba(0,0,0,.08); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .contact-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--acc) 35%, var(--bd)); box-shadow: 0 16px 34px rgba(0,0,0,.12); }
  .contact-card-mail { background: linear-gradient(135deg, color-mix(in srgb, #22d3ee 10%, var(--card)), var(--card)); }
  .contact-card-donate { background: linear-gradient(135deg, color-mix(in srgb, #f59e0b 14%, var(--card)), var(--card)); }
  .card-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 14px; background: color-mix(in srgb, var(--bg) 70%, #fff 30%); border: 1px solid var(--bd); font-size: 1.2rem; margin-bottom: 10px; }
  .card-tag { margin: 0 0 4px; font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--acc); }
  .contact-card h3 { margin: 0 0 6px; font-size: 1.15rem; }
  .contact-card p { margin: 0 0 12px; color: var(--mut); }
  .contact-link-btn, .donate-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 10px 16px; border-radius: 999px; font-weight: 700; text-decoration: none; transition: transform .15s ease, filter .2s ease, box-shadow .2s ease; }
  .contact-link-btn { color: var(--fg); background: var(--bg); border: 1px solid var(--bd); }
  .contact-link-btn:hover { border-color: var(--acc); transform: translateY(-1px); }
  .donate-btn { background: linear-gradient(135deg, #f59e0b, #fb7185); color: #fff; border: 0; box-shadow: 0 10px 20px rgba(245,158,11,.22); }
  .donate-btn:hover { filter: brightness(1.04); transform: translateY(-1px); }
  .contact-link-btn:focus-visible, .donate-btn:focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; }
  .muted-note { margin: 10px 0 0 !important; color: var(--mut) !important; font-size: .85rem; }

  @media (max-width: 820px) {
    .contact-hero { grid-template-columns: 1fr; gap: 8px; }
    .contact-art { min-height: 180px; }
    .coffee-svg { width: min(100%, 240px); }
  }
  @media (max-width: 640px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cup-wrap, .steam-line, .floater, .face .eye, .art-glow, .contact-card, .contact-link-btn, .donate-btn { animation: none !important; transition: none !important; }
  }
 </style>

 <script>
  import glossaryData from '../data/glossary.json';
  const GLOSSARY = glossaryData.entries as any[];
  import { readProgress, setModuleProgress } from '../lib/progress';
  import { readRewardState, writeRewardState, getLevel, resetRewardState } from '../lib/rewards';

  const themeInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="theme"]'));
  themeInputs.forEach((input) => {
   input.checked = input.value === document.documentElement.dataset.theme;
   input.addEventListener('change', () => {
    if (input.checked) document.documentElement.dataset.theme = input.value;
   });
  });

  // Tooltips accesibles por teclado
  document.querySelectorAll<HTMLElement>('.term').forEach((el) => {
   el.setAttribute('tabindex', '0');
   el.setAttribute('role', 'button');
   el.setAttribute('aria-label', el.dataset.tip ?? '');
  });

  // Persistencia de progreso por módulo
  const toggles = Array.from(document.querySelectorAll<HTMLInputElement>('[data-module-toggle]'));
  const progress = readProgress();
  const summary = document.getElementById('progress-summary');
  function updateProgressSummary() {
   if (!summary) return;
   const done = toggles.filter((t) => t.checked).length;
   summary.textContent = `Progreso: ${done}/${toggles.length} módulos completados`;
  }
  toggles.forEach((toggle) => {
   const id = toggle.dataset.moduleToggle ?? '';
   toggle.checked = Boolean(progress[id]?.completed);
   toggle.addEventListener('change', () => {
    setModuleProgress(id, { completed: toggle.checked });
    updateProgressSummary();
   });
  });
  updateProgressSummary();

  const levelEl = document.getElementById('progress-level');
  const barFill = document.getElementById('progress-bar-fill');
  const xpEl = document.getElementById('progress-xp');
  const badgesEl = document.getElementById('progress-badges');
  const modulesEl = document.getElementById('progress-modules');
  const soundToggle = document.getElementById('sound-toggle') as HTMLInputElement | null;
  const resetButton = document.getElementById('reset-progress');

  function updateProgressPanel(): void {
   const state = readRewardState();
   const level = getLevel(state.xp);
   if (levelEl) levelEl.textContent = level.name;
   if (barFill) barFill.style.width = `${Math.round(level.progress * 100)}%`;
   if (xpEl) xpEl.textContent = `${state.xp} XP${level.next ? ` · siguiente nivel: ${level.next} XP` : ''}`;
   if (badgesEl) badgesEl.textContent = state.badges.length ? state.badges.join(', ') : '—';
   if (modulesEl) modulesEl.textContent = String(state.awardedModules.length);
   if (soundToggle) soundToggle.checked = state.soundEnabled;
  }
  if (soundToggle) {
   soundToggle.checked = readRewardState().soundEnabled;
   soundToggle.addEventListener('change', () => {
    const state = readRewardState();
    state.soundEnabled = soundToggle.checked;
    writeRewardState(state);
   });
  }
  resetButton?.addEventListener('click', () => {
   if (!window.confirm('¿Reiniciar todo el progreso y los puntos?')) return;
   resetRewardState();
   updateProgressPanel();
   updateProgressSummary();
  });
  updateProgressPanel();
  window.addEventListener('progress:changed', updateProgressPanel);

  // Resaltado del índice de módulos según scroll
  const moduleLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.module-index a'));
  const moduleSections = moduleLinks
   .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') ?? ''))
   .filter((s): s is HTMLElement => Boolean(s));
  const modObserver = new IntersectionObserver(
   (entries) => {
    const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (!visible) return;
    moduleLinks.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === '#' + visible.target.id));
   },
   { rootMargin: '-20% 0px -70% 0px', threshold: [0.1, 0.4] },
  );
  moduleSections.forEach((s) => modObserver.observe(s));

  // Scroll reveal
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
  function isInView(el: HTMLElement) {
   const r = el.getBoundingClientRect();
   return r.top < window.innerHeight && r.bottom > 0;
  }
  const revealObserver = new IntersectionObserver((entries) => {
   entries.forEach((e) => {
    if (e.isIntersecting) {
     e.target.classList.add('is-visible');
     revealObserver.unobserve(e.target);
    }
   });
  }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach((el) => {
   if (isInView(el)) el.classList.add('is-visible');
   else revealObserver.observe(el);
  });
  // Fallback: make all reveals visible after 1s (safety net)
  setTimeout(() => {
   revealEls.forEach((el) => {
    if (!el.classList.contains('is-visible')) el.classList.add('is-visible');
   });
  }, 1000);

  // Glosario emergente (modal) con interruptor
  const GLOSSARY_KEY = 'progressive-music:glossary-modals';
  const toggle = document.getElementById('glossary-toggle') as HTMLInputElement | null;
  let glossaryEnabled = true;
  try {
   const stored = window.localStorage.getItem(GLOSSARY_KEY);
   glossaryEnabled = stored === null ? true : stored === '1';
  } catch { /* ignore */ }
  function applyGlossaryState() {
   document.body.classList.toggle('glossary-disabled', !glossaryEnabled);
  }
  applyGlossaryState();
  if (toggle) {
   toggle.checked = glossaryEnabled;
   toggle.addEventListener('change', () => {
    glossaryEnabled = toggle.checked;
    applyGlossaryState();
    try { window.localStorage.setItem(GLOSSARY_KEY, glossaryEnabled ? '1' : '0'); } catch { /* ignore */ }
   });
  }

  const modal = document.getElementById('glossary-modal');
  const modalTitle = document.getElementById('glossary-modal-title');
  const modalDef = document.getElementById('glossary-modal-def');
  const modalMeta = document.getElementById('glossary-modal-meta');
  function openGlossary(term: string, tip: string) {
   if (!glossaryEnabled || !modal) return;
   const entry = GLOSSARY.find((e) => e.term.toLowerCase() === term.toLowerCase());
   if (modalTitle) modalTitle.textContent = entry?.term ?? term;
   if (modalDef) modalDef.textContent = entry?.definicion ?? tip;
   if (modalMeta) modalMeta.textContent = entry ? `${entry.ingles ?? ''} · ${(entry.categoria || []).join(', ')}${entry.verificar ? ' · Dato por verificar' : ''}`.replace(/^ · /, '') : '';
   modal.hidden = false;
  }
  function closeGlossary() {
   if (modal) modal.hidden = true;
  }
  document.querySelector('[data-close-glossary]')?.addEventListener('click', closeGlossary);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeGlossary(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGlossary(); });

  document.querySelectorAll<HTMLElement>('.term').forEach((el) => {
   el.style.cursor = 'pointer';
   const activate = (ev?: Event) => {
    ev?.preventDefault();
    openGlossary(el.textContent?.trim() ?? '', el.dataset.tip ?? '');
   };
   el.addEventListener('click', activate);
   el.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter' || ev.key === ' ') activate(ev);
   });
  });
 </script>
</Layout>
