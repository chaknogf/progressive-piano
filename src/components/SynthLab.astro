---
---
<div class="row" style="font-weight:700">
  <span class="box" style="margin:0;text-align:center">Oscilador<br /><small class="mut">genera la forma de onda</small></span>→<span class="box" style="margin:0;text-align:center">Filtro (VCF)<br /><small class="mut">corta agudos o graves</small></span>→<span class="box" style="margin:0;text-align:center">Amplificador (VCA)<br /><small class="mut">volumen y forma ADSR</small></span>
</div>
<div class="grid">
  <div class="cd">
    <h4>1. Osciladores · tu materia prima</h4>
    <div class="row" id="wf" role="group" aria-label="Forma de onda"></div>
    <svg viewBox="0 0 300 80" class="kb" id="wsv" role="img" aria-label="Forma de onda seleccionada"></svg>
    <ul>
      <li><b>Seno:</b> la onda más pura, sin armónicos superiores: un sonido redondo y sordo. Sub-bajos profundos, flautas sintéticas y tonos de prueba.</li>
      <li><b>Sierra:</b> contiene todos los armónicos (pares e impares): rica, brillante, afilada y agresiva. Reina de los leads, de los colchones de cuerdas del synth-pop de los 80 y de los bajos gruesos con distorsión.</li>
      <li><b>Cuadrada:</b> solo armónicos impares; timbre hueco y nasal. Bajos de videojuego retro (8 bits), sonidos tipo clarinete y bajos oscuros de synthwave.</li>
      <li><b>Triangular:</b> muy pocos armónicos; un punto medio cálido entre el seno y la cuadrada. Bajos suaves y orgánicos, y emulaciones sencillas de pianos eléctricos vintage.</li>
    </ul>
  </div>
  <div class="cd">
    <h4>2. Envolvente ADSR · el volumen en el tiempo</h4>
    <div class="row" id="pr" role="group" aria-label="Presets de sonido"></div>
    <svg viewBox="0 0 300 80" class="kb" id="env" role="img" aria-label="Envolvente ADSR"></svg>
    <label class="mut" style="display:block">Attack <b id="va"></b> s<input type="range" id="ra" min="0.005" max="2" step="0.005" style="width:100%" /></label>
    <label class="mut" style="display:block">Decay <b id="vd"></b> s<input type="range" id="rd" min="0.01" max="2" step="0.01" style="width:100%" /></label>
    <label class="mut" style="display:block">Sustain <b id="vs"></b><input type="range" id="rs" min="0" max="1" step="0.01" style="width:100%" /></label>
    <label class="mut" style="display:block">Release <b id="vr"></b> s<input type="range" id="rr" min="0.05" max="3" step="0.01" style="width:100%" /></label>
    <ul>
      <li><b>Attack:</b> cuánto tarda en pasar de cero al volumen máximo. Corto (0,01 s): el sonido explota, ideal para pianos, percusiones y bajos. Largo (1 s o más): aparece como una ola que crece, ideal para pads y colchones de acordes.</li>
      <li><b>Decay:</b> cuánto tarda en bajar del pico al nivel de sostén.</li>
      <li><b>Sustain:</b> no es un tiempo sino un nivel de volumen (0–100 %) que se mantiene mientras la tecla sigue presionada.</li>
      <li><b>Release:</b> cuánto tarda en extinguirse al soltar la tecla. Un release largo deja una cola persistente muy elegante en las baladas.</li>
    </ul>
    <button id="ps" type="button">▶ Probar con C – Am – F – G</button>
  </div>
</div>
<script>
  import { getConfig, onSynthConfigChange, playSequence, setAdsr, setWaveform, type Waveform } from '../lib/audio';
  import { chordNotes } from '../lib/theory';

  type EnvKey = 'a' | 'd' | 's' | 'r';

  const initial = getConfig();
  const ENV: Record<EnvKey, number> = {
    a: initial.adsr.attack,
    d: initial.adsr.decay,
    s: initial.adsr.sustain,
    r: initial.adsr.release,
  };
  let WV: Waveform = initial.waveform;

  const WS: Array<[Waveform, string]> = [
    ['sine', 'Seno'],
    ['sawtooth', 'Sierra'],
    ['square', 'Cuadrada'],
    ['triangle', 'Triangular'],
  ];

  const PR: Array<[string, Waveform, number, number, number, number]> = [
    ['Piano', 'triangle', 0.005, 0.6, 0.2, 0.5],
    ['Pad', 'sawtooth', 1.2, 0.5, 0.8, 1.5],
    ['Bajo', 'square', 0.01, 0.2, 0.6, 0.15],
    ['Lead', 'sawtooth', 0.01, 0.1, 0.7, 0.3],
  ];

  const wf = document.getElementById('wf');
  const wsv = document.getElementById('wsv');
  const env = document.getElementById('env');
  const pr = document.getElementById('pr');
  const ps = document.getElementById('ps');

  function wp(t: Waveform): string {
    let d = '';
    for (let x = 0; x <= 300; x++) {
      const p = (x / 150) % 1;
      const y =
        t === 'sine'
          ? Math.sin(p * 6.2832)
          : t === 'sawtooth'
            ? 2 * p - 1
            : t === 'square'
              ? p < 0.5
                ? 1
                : -1
              : 4 * Math.abs(p - 0.5) - 1;
      d += (x ? 'L' : 'M') + x + ' ' + (40 - y * 30).toFixed(1);
    }
    return d;
  }

  function ws(updateAudio = true): void {
    if (wf) {
      wf.innerHTML = WS.map(
        ([v, n]) =>
          `<button class="wb${v === WV ? ' on' : ''}" type="button" data-v="${v}" aria-pressed="${v === WV}">${n}</button>`,
      ).join('');
    }
    if (wsv) {
      wsv.innerHTML = `<path d="${wp(WV)}" fill="none" stroke="var(--acc)" stroke-width="2"/>`;
    }
    const { a, d, s, r } = ENV;
    const k = 300 / (a + d + 0.4 + r);
    const y = 70 - 60 * s;
    if (env) {
      env.innerHTML = `<polygon points="0,70 ${a * k},10 ${(a + d) * k},${y} ${(a + d + 0.4) * k},${y} 300,70" fill="var(--acc2)" stroke="var(--acc)" stroke-width="2"/>`;
    }
    (['a', 'd', 's', 'r'] as EnvKey[]).forEach((x) => {
      const input = document.getElementById('r' + x) as HTMLInputElement | null;
      const label = document.getElementById('v' + x);
      if (input) input.value = String(ENV[x]);
      if (label) label.textContent = String(ENV[x]);
    });
    if (!updateAudio) return;
    setWaveform(WV);
    setAdsr({ attack: ENV.a, decay: ENV.d, sustain: ENV.s, release: ENV.r });
  }

  wf?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-v]');
    const value = button?.dataset.v as Waveform | undefined;
    if (!value) return;
    WV = value;
    ws();
  });

  (['a', 'd', 's', 'r'] as EnvKey[]).forEach((x) => {
    const input = document.getElementById('r' + x) as HTMLInputElement | null;
    input?.addEventListener('input', () => {
      ENV[x] = Number(input.value);
      ws();
    });
  });

  if (pr) {
    pr.innerHTML = PR.map(([n], i) => `<button type="button" data-i="${i}">${n}</button>`).join('');
    pr.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-i]');
      const preset = PR[Number(button?.dataset.i)];
      if (!preset) return;
      const [, wave, a, d, s, r] = preset;
      WV = wave;
      ENV.a = a;
      ENV.d = d;
      ENV.s = s;
      ENV.r = r;
      ws();
    });
  }

  ps?.addEventListener('click', () => {
    playSequence(['C', 'Am', 'F', 'G'].map((name) => chordNotes(name)), 0, 1.4);
  });

  onSynthConfigChange((next) => {
    WV = next.waveform;
    ENV.a = next.adsr.attack;
    ENV.d = next.adsr.decay;
    ENV.s = next.adsr.sustain;
    ENV.r = next.adsr.release;
    ws(false);
  });

  ws();
</script>
