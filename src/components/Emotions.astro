<section class="mode-study" aria-label="Guía interactiva de emociones y modos musicales">
  <div class="cd mdp" id="modes">
    <div class="row">
      <label for="mk">Tónica <select id="mk"></select></label>
    </div>
    <div class="row mode-tabs" id="mb" role="group" aria-label="Elige uno de los siete modos"></div>
    <div class="mode-spectrum" aria-hidden="true"></div>
    <div class="row mut mode-spectrum-labels" aria-hidden="true"><span>Más luminoso</span><span>Más oscuro</span></div>
    <h3 id="mt"></h3>
    <p id="md"></p>
    <p class="mode-formula"><b>Fórmula:</b> <span id="mode-formula"></span></p>
    <p class="gr" id="mg"></p>
    <p class="mode-characteristic" id="mode-characteristic"></p>
    <h4>Escala en el piano · la nota característica aparece en rosa</h4>
    <div id="mp"></div>
    <h4>Progresión armónica de referencia</h4>
    <div class="chips" id="mc"></div>
    <div class="v"></div>
    <div class="row mode-actions">
      <button id="msc" type="button">▶ Escala</button>
      <button id="mpr" type="button">▶ Progresión</button>
    </div>

    <div class="mode-melody-section">
      <h4>Motivos de ejemplo</h4>
      <p class="mut">Cada botón toca el sintetizador actual del manual. Los motivos modales son originales; el tema jónico es el «Himno a la alegría» de Beethoven, de dominio público. Las referencias culturales sirven para escuchar el color y no incluyen transcripciones.</p>
      <div class="mode-examples" id="mode-examples"></div>
      <div class="mode-live-player">
        <div>
          <b>Teclado en vivo</b>
          <p class="mut" id="melody-status" role="status" aria-live="polite">Elige un motivo para escuchar y ver sus notas.</p>
        </div>
        <div id="melody-keyboard" aria-label="Teclado que ilumina cada nota reproducida"></div>
        <button type="button" id="melody-stop" disabled>■ Detener melodía</button>
      </div>
    </div>
  </div>

  <div class="mode-techniques">
    <h3 id="mode-study-title">Color armónico · dos recursos para cambiar la emoción</h3>
    <div class="mode-technique-grid">
      <article class="cd mode-technique">
        <span class="tg">Intercambio modal</span>
        <h4>El IV menor: una lágrima romántica</h4>
        <p>En Do mayor, cambia por un instante el acorde prestado de Fa mayor por Fa menor: <b>C – F – C</b> frente a <b>C – Fm – C</b>. El Fm viene del modo paralelo Do menor; esa tercera rebajada crea un giro nostálgico, frecuente en baladas y pop romántico.</p>
        <p>Compáralos tocando los botones. Este color aparece también en el giro romántico del <a href="#s3">catálogo de progresiones</a> y en la secuencia <b>I – III – IV – iv</b> asociada a «Creep».</p>
        <div class="mode-play-pair" role="group" aria-label="Comparar progresiones con y sin intercambio modal">
          <button type="button" data-color-progression="C F C" aria-pressed="false">▶ C – F – C</button>
          <button type="button" data-color-progression="C Fm C" aria-pressed="false">▶ C – Fm – C</button>
        </div>
      </article>
      <article class="cd mode-technique">
        <span class="tg">Suspensión</span>
        <h4>Sus2 y sus4: dejar la pregunta abierta</h4>
        <p>Los acordes suspendidos sustituyen la tercera por la segunda o la cuarta: <b>sus2 = 1 – 2 – 5</b> y <b>sus4 = 1 – 4 – 5</b>. Al faltar la tercera, no se definen como mayores ni menores; crean una espera que suele resolverse al acorde mayor.</p>
        <p>Escucha <b>Csus2 → C</b> y <b>Gsus4 → G</b>.</p>
        <div class="mode-play-pair" role="group" aria-label="Escuchar resolución de acordes suspendidos">
          <button type="button" data-color-progression="Csus2 C" aria-pressed="false">▶ Csus2 – C</button>
          <button type="button" data-color-progression="Gsus4 G" aria-pressed="false">▶ Gsus4 – G</button>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { MODES } from '../data/modes';
  import { FLAT_NAMES, NOTE_NAMES, chordNotes, displayNote, keyboardSvg } from '../lib/theory';
  import { playMelody, playSequence } from '../lib/audio';
  import { $, must } from '../lib/dom';

  const root = must(document.getElementById('modes'), '#modes');
  const tonicSelect = must($<HTMLSelectElement>('#mk', root), '#mk');
  const modeButtons = must($('#mb', root), '#mb');
  const title = must($('#mt', root), '#mt');
  const description = must($('#md', root), '#md');
  const formula = must($('#mode-formula', root), '#mode-formula');
  const degrees = must($('#mg', root), '#mg');
  const characteristic = must($('#mode-characteristic', root), '#mode-characteristic');
  const scale = must($('#mp', root), '#mp');
  const chips = must($('#mc', root), '#mc');
  const view = must($('.v', root), '.v');
  const scaleButton = must($('#msc', root), '#msc');
  const progressionButton = must($('#mpr', root), '#mpr');
  const examples = must($('#mode-examples', root), '#mode-examples');
  const exampleKeyboard = must($('#melody-keyboard', root), '#melody-keyboard');
  const melodyStatus = must($('#melody-status', root), '#melody-status');
  const stopButton = must($('#melody-stop', root), '#melody-stop');

  tonicSelect.innerHTML = FLAT_NAMES.map((name, index) => `<option value="${index}">${displayNote(name)}</option>`).join('');
  let current = 1;
  let cancelMelody: (() => void) | null = null;
  let activePlayButton: HTMLButtonElement | null = null;

  modeButtons.innerHTML = MODES.map((mode, index) =>
    `<button class="mm${index === current ? ' on' : ''}" type="button" data-i="${index}" aria-pressed="${index === current}">${mode.name}</button>`,
  ).join('');

  function renderExampleCards(): void {
    examples.innerHTML = MODES.map((mode, index) => {
      const references = mode.listen.length
        ? `<div class="listen-list"><b>Escucha sugerida</b>${mode.listen.map((item) => `<p><a href="${item.source}" target="_blank" rel="noreferrer">${item.title} · ${item.artist}</a> <span class="listen-status">${item.status}</span><br /><small>${item.note} <span class="listen-source">Fuente: ${item.sourceLabel}</span></small></p>`).join('')}</div>`
        : '<div class="listen-list"><b>Escucha sugerida</b><p class="mut">Sin atribuciones de obras concretas verificadas para este modo.</p></div>';
      const melodyName = mode.id === 'jonico' ? 'Himno a la alegría · Beethoven' : 'Motivo de ejemplo (original)';
      return `<article class="mode-example-card" data-mode-card="${mode.id}">
        <span class="mode-icon" aria-hidden="true">${['✨', '☀️', '🛣️', '🌙', '🌧️', '🔥', '🌀'][index]}</span>
        <h4>${mode.name}</h4><p class="mode-emotion">${mode.emotion}</p>
        <p class="mode-card-formula"><b>Fórmula:</b> ${mode.formula}</p>
        <p><b>Grado característico:</b> ${mode.formula.split(' – ')[mode.characteristic]}.</p>
        <p><b>Progresión:</b> ${mode.degrees}</p>
        <p class="mode-cue">${['Cine fantástico y asombro espacial', 'Himnos luminosos y sensación de llegada', 'Rock abierto y espíritu de carretera', 'Jazz modal y groove nostálgico', 'Drama íntimo y balada', 'Tensión flamenca y final dramático', 'Inquietud y suspenso'][index]}</p>
        ${references}
        <button type="button" class="mode-melody-play" data-play-melody="${index}" aria-pressed="false">▶ Escuchar melodía de ejemplo <small>${melodyName}</small></button>
      </article>`;
    }).join('');
  }

  function render(): void {
    const mode = MODES[current];
    const key = Number(tonicSelect.value);
    const scaleNotes = mode.scale.map((step) => key + step).concat(key + 12);
    const characteristicNote = key + mode.scale[mode.characteristic];
    const progression = mode.progression.map(
      ([offset, quality]) => FLAT_NAMES[((key + offset) % 12 + 12) % 12] + quality,
    );

    title.textContent = `${displayNote(FLAT_NAMES[key])} ${mode.name}`;
    description.innerHTML = `<b>${mode.emotion}.</b> ${mode.description}`;
    formula.textContent = mode.formula;
    degrees.textContent = `Grados: ${mode.degrees}`;
    characteristic.textContent = `Nota característica: ${mode.formula.split(' – ')[mode.characteristic]} (${NOTE_NAMES[(characteristicNote % 12 + 12) % 12]}).`;
    scale.innerHTML = `${keyboardSvg(scaleNotes, undefined, undefined, characteristicNote)}<p class="nn">${scaleNotes.map((note) => NOTE_NAMES[note % 12]).join(' – ')}</p>`;
    exampleKeyboard.innerHTML = keyboardSvg(
      mode.scale.map((step) => 60 + key + step),
      undefined,
      undefined,
      60 + characteristicNote,
    );
    chips.innerHTML = progression.map((chord) => `<button class="ch" type="button" data-n="${chord}">${displayNote(chord)}</button>`).join('');
    view.innerHTML = '';
    modeButtons.querySelectorAll<HTMLButtonElement>('.mm').forEach((button) => {
      const selected = Number(button.dataset.i) === current;
      button.classList.toggle('on', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
  }

  function finishMelody(): void {
    cancelMelody = null;
    stopButton.disabled = true;
    activePlayButton?.setAttribute('aria-pressed', 'false');
    activePlayButton = null;
    melodyStatus.textContent = 'La melodía terminó o se detuvo.';
    render();
  }

  function startMelody(index: number, button: HTMLButtonElement): void {
    cancelMelody?.();
    const mode = MODES[index];
    const key = Number(tonicSelect.value);
    const base = 60 + key;
    const characteristicPitch = base + mode.scale[mode.characteristic];
    const pitches = mode.melody.map(([semitones]) => base + semitones);
    const low = Math.floor(Math.min(...pitches) / 12) * 12;
    const high = (Math.floor(Math.max(...pitches) / 12) + 1) * 12;
    activePlayButton = button;
    button.setAttribute('aria-pressed', 'true');
    stopButton.disabled = false;
    melodyStatus.textContent = `Reproduciendo: ${mode.name}.`;
    cancelMelody = playMelody(mode.melody.map(([semitones, beats]) => [base + semitones, beats] as const), 96, (noteIndex) => {
      if (noteIndex < 0) { finishMelody(); return; }
      const pitch = pitches[noteIndex];
      exampleKeyboard.innerHTML = keyboardSvg([pitch], low, high, characteristicPitch);
      melodyStatus.textContent = `${mode.name}: ${NOTE_NAMES[((pitch % 12) + 12) % 12]} · nota ${noteIndex + 1} de ${pitches.length}`;
    });
  }

  modeButtons.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.mm');
    if (!button) return;
    cancelMelody?.();
    current = Number(button.dataset.i ?? 0);
    render();
  });
  tonicSelect.addEventListener('change', () => { cancelMelody?.(); render(); });
  scaleButton.addEventListener('click', () => {
    const mode = MODES[current];
    const key = Number(tonicSelect.value);
    playSequence(mode.scale.map((step) => [key + step]), 0, 0.35);
  });
  progressionButton.addEventListener('click', () => {
    const mode = MODES[current];
    const key = Number(tonicSelect.value);
    const progression = mode.progression.map(
      ([offset, quality]) => FLAT_NAMES[((key + offset) % 12 + 12) % 12] + quality,
    );
    playSequence(progression.map((chord) => chordNotes(chord)), 0, 1.2);
  });
  examples.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-play-melody]');
    if (button) startMelody(Number(button.dataset.playMelody), button);
  });
  stopButton.addEventListener('click', () => cancelMelody?.());

  document.querySelectorAll<HTMLButtonElement>('[data-color-progression]').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-color-progression]').forEach((item) => {
        item.setAttribute('aria-pressed', String(item === button));
      });
      const names = (button.dataset.colorProgression ?? '').split(' ');
      playSequence(names.map((name) => chordNotes(name)), 0, 0.8);
    });
  });

  renderExampleCards();
  render();
</script>

<style is:global>
  .mode-study { display:grid; gap:1.3rem; }
  .mode-spectrum { height:8px; border-radius:99px; background:linear-gradient(90deg,#fbbf24,#fb923c,#ec4899,#8b5cf6,#1e1b4b); }
  .mode-spectrum-labels { justify-content:space-between; margin-top:-.75rem; }
  .mode-tabs { display:flex; flex-wrap:wrap; gap:.45rem; }
  .mode-tabs button { border:1px solid var(--bd); border-radius:999px; padding:.45rem .7rem; background:var(--bg); color:var(--fg); cursor:pointer; }
  .mode-tabs button.on { background:var(--acc2); border-color:var(--acc); }
  .mode-formula { padding:.55rem .75rem; border-radius:12px; background:var(--acc2); }
  .mode-characteristic { padding:.55rem .75rem; border-left:3px solid #ec4899; background:color-mix(in srgb,var(--card) 75%,#ec4899 25%); border-radius:0 10px 10px 0; }
  .mode-melody-section { margin-top:1.2rem; }
  .mode-examples { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:.75rem; }
  .mode-example-card { display:flex; flex-direction:column; align-items:flex-start; gap:.4rem; padding:1rem; border:1px solid var(--bd); border-radius:18px; background:var(--card); }
  .mode-example-card h4 { margin:0; color:var(--fg); text-transform:none; letter-spacing:normal; font:700 1.1rem Georgia,serif; }
  .mode-example-card p { margin:.1rem 0; }
  .mode-icon { font-size:1.5rem; }
  .mode-emotion { color:var(--mut); font-size:.88rem; }
  .mode-card-formula { color:var(--acc); }
  .mode-cue { font-weight:650; }
  .listen-list { width:100%; border-top:1px solid var(--bd); padding-top:.5rem; margin-top:.25rem; font-size:.82rem; }
  .listen-list p { margin:.4rem 0; }
  .listen-list small { color:var(--mut); }
  .listen-status { display:inline-block; color:var(--mut); font-size:.7rem; text-transform:uppercase; }
  .listen-source { display:block; }
  .mode-melody-play { margin-top:auto; width:100%; min-height:48px; text-align:left; border:1px solid var(--bd); border-radius:13px; padding:.6rem .75rem; background:var(--acc2); color:var(--fg); cursor:pointer; }
  .mode-melody-play[aria-pressed="true"] { border-color:var(--acc); box-shadow:0 0 0 2px color-mix(in srgb,var(--acc) 25%,transparent); }
  .mode-melody-play small { display:block; color:var(--mut); }
  .mode-live-player { display:grid; grid-template-columns:minmax(180px,1fr) minmax(220px,1.3fr) auto; align-items:center; gap:.75rem; margin-top:.8rem; padding:.85rem; border:1px solid var(--bd); border-radius:16px; background:var(--bg); }
  .mode-live-player p { margin:.2rem 0 0; }
  .mode-live-player button { border:1px solid var(--bd); border-radius:12px; padding:.5rem .75rem; background:var(--card); color:var(--fg); }
  .mode-techniques h3 { margin-bottom:.7rem; }
  .mode-technique-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr)); gap:.8rem; }
  .mode-technique { margin:0; }
  .mode-play-pair { display:flex; flex-wrap:wrap; gap:.5rem; }
  .mode-play-pair button { border:1px solid var(--bd); border-radius:12px; padding:.55rem .7rem; background:var(--acc2); color:var(--fg); cursor:pointer; }
  .mode-play-pair button[aria-pressed="true"] { border-color:var(--acc); }
  @media(max-width:650px) { .mode-live-player { grid-template-columns:1fr; } .mode-live-player .kb { max-width:100%; } }
  @media(prefers-reduced-motion:reduce) { .mode-study *, .mode-study *::before, .mode-study *::after { scroll-behavior:auto!important; transition:none!important; animation:none!important; } }
</style>
