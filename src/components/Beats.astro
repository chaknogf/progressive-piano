<section id="s10">
  <h2>10. Ritmo y percusión: beats por género</h2>
  <p>La percusión define la energía, la cadencia y el movimiento de un track. Cada elemento ocupa un lugar en el espectro de frecuencias y en el compás.</p>
  <div class="scroll">
    <table>
      <tr><th>Instrumento</th><th>Función y rango</th><th>Mejor momento para usarlo</th></tr>
      <tr><td><b>Kick (bombo)</b></td><td>Cimiento grave (20–100 Hz): peso y pulso principal.</td><td>Inicio de los compases y acentos fuertes.</td></tr>
      <tr><td><b>Snare (caja)</b></td><td>Ancla de frecuencia media (200 Hz–2 kHz): responde al kick en los tiempos débiles (backbeat).</td><td>Tiempos 2 y 4 (o el 3 en trap).</td></tr>
      <tr><td><b>Clap (palmas)</b></td><td>Alternativa o capa de la caja.</td><td>Coros o secciones que piden más brillo.</td></tr>
      <tr><td><b>Hi-hat cerrado</b></td><td>Agudos (5–18 kHz): marca la subdivisión y el groove.</td><td>Estrofas, para mantener el control del tempo.</td></tr>
      <tr><td><b>Hi-hat abierto</b></td><td>Apertura de energía y elevación.</td><td>Contratiempo del coro, para dar soltura.</td></tr>
      <tr><td><b>Congas / bongós</b></td><td>Relleno orgánico en medios-agudos; síncopa y movimiento.</td><td>Afrobeat, salsa, funk y house, para llenar huecos.</td></tr>
      <tr><td><b>Toms</b></td><td>Percusión tonal dinámica (grave, medio, agudo).</td><td>Fills al final de 4 u 8 compases y build-ups antes de un drop.</td></tr>
      <tr><td><b>Rimshot / sidestick</b></td><td>Percusión suave de bajo impacto.</td><td>Estrofas tranquilas o baladas, donde una caja completa sería agresiva.</td></tr>
    </table>
  </div>
  <h3 style="margin-top:1.4em">Secuenciador de beats</h3>
  <p>Cada columna es una semicorchea; las líneas gruesas marcan los 4 tiempos del compás. Elige un género, activa o apaga casillas y juega con el tempo y el swing. Con “Con acordes” suena además una progresión, con el timbre que hayas elegido en la sección 8.</p>
  <div class="sim">
    <div class="seg" id="bg"></div>
    <div class="row">
      <button id="bp" class="on" type="button">▶ Reproducir</button>
      <label>Tempo <b id="bv"></b> BPM<input type="range" id="bt" min="60" max="180"></label>
      <label>Swing <b id="bw"></b> %<input type="range" id="bs" min="0" max="50"></label>
      <label style="flex-direction:row;align-items:center;gap:6px"><input type="checkbox" id="bc"> Con acordes</label>
      <button id="bx" type="button">Limpiar</button>
    </div>
    <div class="sq" id="bgrid"></div>
    <p class="mut" id="bch"></p>
  </div>
  <div class="box hl" id="bn"></div>
  <h3 style="margin-top:1.4em">Notación del ritmo</h3>
  <p>Así se escribe el patrón en un pentagrama de percusión (una sola línea, un compás de 4/4). Elige una pista: cada casilla activa se convierte en una figura y la partitura cambia al editar la cuadrícula. Debajo de cada paso está el conteo en voz alta: 1 e y a, 2 e y a…</p>
  <div class="seg" id="nb"></div>
  <div class="fb"><svg id="nv" viewBox="0 0 640 120" style="min-width:560px;color:var(--fg)" role="img" aria-label="Pentagrama del patrón"></svg></div>
  <p class="mut">Cada golpe dura hasta el siguiente golpe del mismo pulso; si un golpe cruza al pulso siguiente, se corta ahí por simplicidad. Una casilla de la cuadrícula es una semicorchea.</p>
  <h4>Figuras y silencios</h4>
  <div id="fgz"></div>
  <h3 style="margin-top:1.4em">Armonía y percusión: la radiografía por género</h3>
  <p>Cada género combina un tipo de acordes con un tipo de beat. Toca los acordes para ver su teclado y su diapasón.</p>
  <div class="grid" id="bcards"></div>
</section>
<script>
  import { audioContext, scheduleTone } from '../lib/audio';
  import { BEAT_GENRES, BEAT_INSTRUMENTS, HARMONY_CARDS } from '../data/beats';
  import { chordNotes as notes, displayName as dn } from '../lib/theory';

  const $ = (s: string, e: ParentNode = document): any => e.querySelector(s);
  const $$ = (s: string, e: ParentNode = document): any[] => [...e.querySelectorAll(s)];

  const TR = BEAT_INSTRUMENTS;
  const GN = BEAT_GENRES;
  const CD = HARMONY_CARDS;

  let gi = 0;
  let G: boolean[][] = [];
  let on = 0;
  let step = 0;
  let bar = 0;
  let bs = 0;
  let tm: ReturnType<typeof setInterval>;
  let AC: AudioContext;
  let NB: AudioBuffer | null = null;

  function ac(): void {
    AC = audioContext();
    if (AC.state === 'suspended') AC.resume();
    if (!NB) {
      NB = AC.createBuffer(1, AC.sampleRate, AC.sampleRate);
      const d = NB.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
    }
  }

  function drum(r: number, t: number): void {
    const g = AC.createGain();
    g.connect(AC.destination);
    if (r == 0 || r == 4) {
      const o = AC.createOscillator();
      const k = r == 0;
      o.frequency.setValueAtTime(k ? 150 : 260, t);
      o.frequency.exponentialRampToValueAtTime(k ? 42 : 190, t + (k ? 0.12 : 0.1));
      g.gain.setValueAtTime(k ? 0.9 : 0.4, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + (k ? 0.35 : 0.18));
      o.connect(g);
      o.start(t);
      o.stop(t + 0.4);
      return;
    }
    const n = AC.createBufferSource();
    const f = AC.createBiquadFilter();
    const d = r == 1 ? 0.2 : r == 2 ? 0.05 : 0.3;
    n.buffer = NB;
    f.type = r == 1 ? 'bandpass' : 'highpass';
    f.frequency.value = r == 1 ? 1800 : 7000;
    g.gain.setValueAtTime(r == 1 ? 0.7 : 0.25, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + d);
    n.connect(f);
    f.connect(g);
    n.start(t);
    n.stop(t + d + 0.05);
    if (r == 1) {
      const o = AC.createOscillator();
      const h = AC.createGain();
      o.type = 'triangle';
      o.frequency.setValueAtTime(200, t);
      h.gain.setValueAtTime(0.3, t);
      h.gain.exponentialRampToValueAtTime(0.001, t + 0.1);
      o.connect(h);
      h.connect(AC.destination);
      o.start(t);
      o.stop(t + 0.12);
    }
  }

  function cur(k: number): void {
    $$('#bgrid .cl').forEach((c) => c.classList.toggle('cur', +c.dataset.k == k));
  }

  function sched(): void {
    const bpm = +$('#bt').value;
    const sw = $('#bs').value / 100;
    const sd = 60 / bpm / 4;
    while (bs + step * sd < AC.currentTime + 0.15) {
      const st = step;
      const t = bs + st * sd + (st % 2 ? sw * sd : 0);
      G.forEach((row, r) => {
        if (row[st]) drum(r, t);
      });
      if (!st && $('#bc').checked) {
        notes(GN[gi].chords[bar % 4]).forEach((n) => scheduleTone(n - 12, t, sd * 15));
      }
      setTimeout(() => on && cur(st), Math.max(0, (t - AC.currentTime) * 1000));
      if (++step == 16) {
        step = 0;
        bs += 16 * sd;
        bar++;
      }
    }
  }

  function stop(): void {
    on = 0;
    clearInterval(tm);
    $('#bp').textContent = '▶ Reproducir';
    cur(-1);
  }

  function lab(): void {
    $('#bv').textContent = $('#bt').value;
    $('#bw').textContent = $('#bs').value;
  }

  let nk = 0;
  const XP = (st: number): number => 82 + st * 33;
  const FC2 = 'fill="currentColor"';
  const SC2 = 'stroke="currentColor"';

  function rst(x: number, d: number): string {
    if (d == 4) {
      return `<path d="M${x} 56 l6 8 l-6 8 l6 8" fill="none" ${SC2} stroke-width="2.6"/>`;
    }
    const e = `<circle cx="${x}" cy="62" r="2.6" ${FC2}/><path d="M${x + 4} 60 q-4 10-9 22" fill="none" ${SC2} stroke-width="2"/>`;
    return d == 1
      ? e + `<circle cx="${x - 2}" cy="72" r="2.6" ${FC2}/>`
      : d == 2
        ? e
        : e + `<circle cx="${x + 10}" cy="62" r="1.6" ${FC2}/>`;
  }

  function nr(): void {
    const row = G[nk];
    $('#nb').innerHTML = TR.map(
      (n, i) => `<button data-i="${i}" class="${i == nk ? 'on' : ''}" type="button">${n}</button>`,
    ).join('');
    let g = `<line x1="60" y1="70" x2="632" y2="70" ${SC2}/><rect x="14" y="58" width="4" height="24" ${FC2}/><rect x="24" y="58" width="4" height="24" ${FC2}/><text x="46" y="66" font-size="20" font-family="Georgia,serif" font-weight="700" text-anchor="middle" ${FC2}>4</text><text x="46" y="86" font-size="20" font-family="Georgia,serif" font-weight="700" text-anchor="middle" ${FC2}>4</text><line x1="60" y1="58" x2="60" y2="82" ${SC2}/><line x1="627" y1="58" x2="627" y2="82" ${SC2}/><line x1="632" y1="58" x2="632" y2="82" ${SC2} stroke-width="4"/>`;
    for (let st = 0; st < 16; st++) {
      g += `<text x="${XP(st)}" y="108" font-size="11" text-anchor="middle" ${FC2} opacity="${row[st] ? 1 : 0.4}" font-weight="${row[st] ? 700 : 400}">${st % 4 ? ['e', 'y', 'a'][st % 4 - 1] : st / 4 + 1}</text>`;
    }
    for (let b = 0; b < 4; b++) {
      const active: number[] = [];
      for (let i = 0; i < 4; i++) if (row[b * 4 + i]) active.push(b * 4 + i);
      if (b) {
        g += `<line x1="${XP(b * 4) - 16}" y1="58" x2="${XP(b * 4) - 16}" y2="82" ${SC2} opacity=".25" stroke-dasharray="3 3"/>`;
      }
      if (!active.length) {
        g += rst(XP(b * 4), 4);
        continue;
      }
      if (active[0] > b * 4) g += rst(XP(b * 4), active[0] - b * 4);
      const ns = active.map((st, j) => ({ x: XP(st), d: (active[j + 1] ?? b * 4 + 4) - st }));
      ns.forEach((n) => {
        g += `<ellipse cx="${n.x}" cy="70" rx="6" ry="4.3" transform="rotate(-20 ${n.x} 70)" ${FC2}/><line x1="${n.x + 5.2}" y1="68" x2="${n.x + 5.2}" y2="35" ${SC2} stroke-width="1.6"/>`;
        if (n.d == 3) g += `<circle cx="${n.x + 12}" cy="73" r="1.8" ${FC2}/>`;
      });
      if (ns.length > 1) {
        g += `<line x1="${ns[0].x + 5.2}" y1="36" x2="${ns[ns.length - 1].x + 5.2}" y2="36" ${SC2} stroke-width="4"/>`;
        ns.forEach((n, j) => {
          if (n.d != 1) return;
          const nx = ns[j + 1];
          const pv = ns[j - 1];
          const a = n.x + 5.2;
          if (nx && nx.d == 1) {
            g += `<line x1="${a}" y1="44" x2="${nx.x + 5.2}" y2="44" ${SC2} stroke-width="3.5"/>`;
          } else if (!(pv && pv.d == 1)) {
            g += `<line x1="${a}" y1="44" x2="${a + (nx ? 9 : -9)}" y2="44" ${SC2} stroke-width="3.5"/>`;
          }
        });
      } else {
        const n = ns[0];
        const fl = n.d == 1 ? 2 : n.d == 4 ? 0 : 1;
        for (let i = 0; i < fl; i++) {
          g += `<path d="M${n.x + 5.2} ${35 + i * 8} q9 5 6 17" fill="none" ${SC2} stroke-width="2"/>`;
        }
      }
    }
    $('#nv').innerHTML = g;
  }

  function fig(k: number, r: number): string {
    const h = (o: boolean): string =>
      `<ellipse cx="15" cy="38" rx="${k == 0 ? 8 : 6.5}" ry="${k == 0 ? 5.5 : 4.6}" transform="rotate(-20 15 38)" ${o ? `fill="none" ${SC2} stroke-width="2.2"` : FC2}/>`;
    if (r) {
      const l = `<line x1="4" y1="22" x2="36" y2="22" ${SC2}/>`;
      if (k == 0) return l + `<rect x="14" y="22" width="12" height="6" ${FC2}/>`;
      if (k == 1) return l + `<rect x="14" y="16" width="12" height="6" ${FC2}/>`;
      if (k == 2) return `<path d="M17 8 l7 10 l-7 10 l7 10" fill="none" ${SC2} stroke-width="3"/>`;
      let q = '';
      for (let i = 0; i < k - 2; i++) q += `<circle cx="${19 - i * 3}" cy="${14 + i * 9}" r="2.8" ${FC2}/>`;
      return q + `<path d="M24 13 q-5 12-10 ${14 + (k - 3) * 9}" fill="none" ${SC2} stroke-width="2"/>`;
    }
    let t = h(k < 2);
    if (k > 0) t += `<line x1="20.2" y1="36" x2="20.2" y2="6" ${SC2} stroke-width="1.8"/>`;
    for (let i = 0; i < k - 2; i++) {
      t += `<path d="M20.2 ${6 + i * 7} q10 5 6 17" fill="none" ${SC2} stroke-width="2.2"/>`;
    }
    return t;
  }

  function lg(): void {
    const L = [
      ['Redonda', '4', '16', 'ta-a-a-a'],
      ['Blanca', '2', '8', 'ta-a'],
      ['Negra', '1', '4', 'ta'],
      ['Corchea', '½', '2', 'ti (ti-ti)'],
      ['Semicorchea', '¼', '1', 'ti-ri (ti-ri-ti-ri)'],
      ['Fusa', '⅛', '½ (1/32)', 'ri-ri-ri-ri…'],
    ];
    $('#fgz').innerHTML =
      `<div class="scroll"><table><tr><th>Figura</th><th>Nombre</th><th>Pulsos</th><th>Pasos de la cuadrícula</th><th>Sílaba rítmica</th><th>Silencio</th></tr>` +
      L.map(
        (x, i) =>
          `<tr><td><svg width="44" height="48" viewBox="0 0 40 46" style="color:var(--fg)">${fig(i, 0)}</svg></td><td><b>${x[0]}</b></td><td>${x[1]}</td><td>${x[2]}</td><td>${x[3]}</td><td><svg width="44" height="48" viewBox="0 0 40 46" style="color:var(--fg)">${fig(i, 1)}</svg></td></tr>`,
      ).join('') +
      `</table></div><p class="mut">El puntillo suma la mitad del valor: negra con puntillo = 1½ pulsos (6 pasos); corchea con puntillo = ¾ de pulso (3 pasos). La fusa no cabe en 16 pasos: es la ráfaga de hi-hats a 1/32 del trap.</p>`;
  }

  function load(i: number): void {
    gi = i;
    const g = GN[i];
    G = g.patterns.map((row) => [...row].map((c) => c == 'x'));
    $('#bt').value = g.bpm;
    $('#bs').value = g.swing;
    lab();
    $('#bg').innerHTML = GN.map(
      (x, j) => `<button data-i="${j}" class="${j == i ? 'on' : ''}" type="button">${x.name}</button>`,
    ).join('');
    $('#bn').innerHTML = `<b>${g.name}.</b> ${g.description}`;
    $('#bch').textContent = `Acordes (un compás cada uno): ${g.chords.map(dn).join(' – ')}`;
    $('#bgrid').innerHTML =
      '<span></span>' +
      [...Array(16)]
        .map(
          (_, k) =>
            `<span class="bc2${k % 4 ? '' : ' bb'}">${k % 4 ? ['e', 'y', 'a'][k % 4 - 1] : k / 4 + 1}</span>`,
        )
        .join('') +
      TR.map(
        (n, r) =>
          `<span class="bl">${n}</span>` +
          G[r]
            .map(
              (v, k) =>
                `<button class="cl${v ? ' on' : ''}${k % 4 ? '' : ' b'}" data-r="${r}" data-k="${k}" aria-label="${n}, semicorchea ${k + 1}" type="button"></button>`,
            )
            .join(''),
      ).join('');
    nr();
  }

  $('#bg').onclick = (e) => {
    const i = e.target.dataset.i;
    if (i != null) load(+i);
  };
  $('#bgrid').onclick = (e) => {
    const b = e.target.closest('.cl');
    if (!b) return;
    const r = +b.dataset.r;
    const k = +b.dataset.k;
    G[r][k] = !G[r][k];
    b.classList.toggle('on', G[r][k]);
    nr();
    if (G[r][k] && !on) {
      ac();
      drum(r, AC.currentTime);
    }
  };
  $('#bt').oninput = $('#bs').oninput = lab;
  $('#bp').onclick = () => {
    if (on) {
      stop();
      return;
    }
    ac();
    on = 1;
    step = 0;
    bar = 0;
    bs = AC.currentTime + 0.08;
    $('#bp').textContent = '■ Detener';
    tm = setInterval(sched, 25);
    sched();
  };
  $('#bx').onclick = () => {
    G = G.map((r) => r.map(() => false));
    $$('#bgrid .cl').forEach((c) => c.classList.remove('on'));
    nr();
  };
  $('#nb').onclick = (e) => {
    const i = e.target.dataset.i;
    if (i != null) {
      nk = +i;
      nr();
    }
  };

  $('#bcards').innerHTML = CD.map(
    (card) =>
      `<article class="cd"><h3>${card.title}</h3><div class="chips">${card.chords
        .split(' ')
        .map((x) => `<button class="ch" type="button" data-n="${x}">${dn(x)}</button>`)
        .join('')}</div><p><b>Armonía.</b> ${card.harmony}</p><p><b>Beat.</b> ${card.beat}</p><div class="v"></div></article>`,
  ).join('');

  lg();
  load(0);
</script>
<style>
  .sq{display:grid;grid-template-columns:72px repeat(16,minmax(0,1fr));gap:3px;align-items:center;margin:10px 0}
  .bl{font-size:.7rem;color:var(--mut);line-height:1.1}
  .cl{height:30px;min-height:0;min-width:0;padding:0;border-radius:5px;border:1px solid var(--bd);background:var(--card)}
  .cl.b{border-left:2px solid var(--mut)}.cl.on{background:var(--acc);border-color:var(--acc)}.cl.cur{outline:2px solid var(--fg);outline-offset:1px}
</style>
