---
---
<svg viewBox="0 0 48 48" role="img" aria-label="progressive-music" class="logo" width="40" height="40">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f97316"/>
      <stop offset=".5" stop-color="#ec4899"/>
      <stop offset="1" stop-color="#8b5cf6"/>
    </linearGradient>
  </defs>
  <rect width="48" height="48" rx="12" fill="url(#g)"/>
  <g fill="#fff" opacity=".35">
    <rect x="7" y="10" width="7" height="28" rx="2"/>
    <rect x="16" y="10" width="7" height="28" rx="2"/>
    <rect x="25" y="10" width="7" height="28" rx="2"/>
    <rect x="34" y="10" width="7" height="28" rx="2"/>
  </g>
  <path d="M6 24 C12 8 18 40 24 24 S36 8 42 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round"/>
</svg>
<style>
  .logo { display: inline-block; vertical-align: middle; }
  @media (prefers-reduced-motion: no-preference) {
    .logo.playing { animation: pulse 0.6s ease-in-out infinite; }
  }
  @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }
</style>
<script>
  // expose a helper to trigger pulse on any .logo when audio plays
  (window as any).__pulseLogo = () => {
    document.querySelectorAll('.logo').forEach((el) => {
      el.classList.add('playing');
      setTimeout(() => el.classList.remove('playing'), 700);
    });
  };
</script>
