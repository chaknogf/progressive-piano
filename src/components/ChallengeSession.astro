---
// src/components/ChallengeSession.astro
// Etapa 1 · Motor de retos gamificados. Isla Astro con TS vanilla (sin React),
// reutilizando rewards.ts, progress.ts, piano-engine.ts y tuner.ts.
import type { Challenge } from "../lib/challenges";

interface Props {
  challenges: Challenge[];
}
const { challenges } = Astro.props;

// Cada módulo tiene su propio número de retos: la barra se ajusta al abrirlo.
const stepsByModule = challenges.reduce<Record<string, number>>((counts, challenge) => {
  counts[challenge.modulo] = (counts[challenge.modulo] ?? 0) + 1;
  return counts;
}, {});
const largestModule = Math.max(0, ...Object.values(stepsByModule));
const steps = Math.min(8, Math.max(5, largestModule));
const NOTE_NAMES = ["Do", "Do♯", "Re", "Re♯", "Mi", "Fa", "Fa♯", "Sol", "Sol♯", "La", "La♯", "Si"];
const WHITE_PCS = [0, 2, 4, 5, 7, 9, 11];
const BLACK_KEYS = [
  { pc: 1, after: 0 },
  { pc: 3, after: 1 },
  { pc: 6, after: 3 },
  { pc: 8, after: 4 },
  { pc: 10, after: 5 },
];
const whiteWidth = 100 / WHITE_PCS.length;
---

<div
  class="challenge-session"
  id="challenge-session"
  data-challenges={JSON.stringify(challenges)}
  data-steps={String(steps)}
  data-steps-by-module={JSON.stringify(stepsByModule)}
  hidden
>
  <div class="ch-backdrop" data-ch-backdrop></div>

  <section
    class="ch-shell"
    id="ch-shell"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ch-title"
    tabindex="-1"
  >
    <header class="ch-header">
      <div class="ch-identity">
        <span class="ch-logo" aria-hidden="true">♫</span>
        <div class="ch-identity-text">
          <span class="ch-kicker" id="ch-module">RETOS</span>
          <strong id="ch-step-label">Reto 1</strong>
        </div>
      </div>

      <div
        class="ch-progress"
        id="ch-progress"
        role="progressbar"
        aria-label="Progreso de la sesión"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        {Array.from({ length: steps }, () => <span class="ch-seg"></span>)}
      </div>

      <div class="ch-header-actions">
        <button
          type="button"
          class="ch-icon-btn"
          id="ch-focus"
          aria-pressed="false"
          aria-label="Activar modo enfoque"
          title="Modo enfoque">◎</button
        >
        <button
          type="button"
          class="ch-icon-btn"
          id="ch-settings-btn"
          aria-expanded="false"
          aria-controls="ch-settings"
          aria-label="Ajustes rápidos"
          title="Ajustes rápidos">⚙</button
        >
        <button type="button" class="ch-exit" id="ch-finish">Terminar por hoy</button>
      </div>
    </header>

    <div class="ch-settings" id="ch-settings" hidden>
      <label class="ch-setting">
        <input type="checkbox" id="ch-sound" />
        <span>Sonido de acierto</span>
      </label>
      <label class="ch-setting">
        <input type="checkbox" id="ch-motion" />
        <span>Reducir movimiento</span>
      </label>
      <label class="ch-setting ch-setting-select">
        <span>Entrada preferida</span>
        <select id="ch-input">
          <option value="pantalla">Pantalla</option>
          <option value="microfono">Micrófono</option>
          <option value="midi">MIDI</option>
        </select>
      </label>
    </div>

    <div class="ch-stage" id="ch-stage">
      <p class="ch-kind" id="ch-kind">ESCUCHA Y ELIGE</p>
      <h2 class="ch-question" id="ch-title">Preparando tu reto…</h2>
      <p class="ch-sub" id="ch-sub">Elige la respuesta que suene bien.</p>

      <button type="button" class="ch-replay" id="ch-replay" hidden aria-label="Volver a reproducir el sonido del reto">
        <span aria-hidden="true">🔊</span>
        <span id="ch-replay-label">Volver a escuchar</span>
      </button>

      <div
        class="ch-pulse"
        id="ch-pulse"
        hidden
        data-expected="[]"
        data-start="0"
        data-tolerance="0"
      >
        <div class="ch-pulse-dots" id="ch-pulse-dots" aria-hidden="true"></div>
        <p class="ch-pulse-status" id="ch-pulse-status" aria-live="polite">
          Preparando el metrónomo…
        </p>
        <button type="button" class="ch-pulse-tap" id="ch-pulse-tap">
          🥁 Tocar pulso
          <small>Espacio</small>
        </button>
      </div>

      <div class="ch-options" id="ch-options" role="group" aria-label="Opciones de respuesta"></div>

      <div class="ch-play" id="ch-play" hidden>
        <p class="ch-target" id="ch-target"></p>
        <div class="ch-keys-scroll">
          <div class="ch-keys" id="ch-keys" role="group" aria-label="Teclado para responder">
            {
              WHITE_PCS.map(
                (pc, i) => (
                  <button
                    type="button"
                    class="ch-key ch-key-white"
                    data-midi={60 + pc}
                    style={`left:${i * whiteWidth}%;width:${whiteWidth}%`}
                    aria-label={`Tocar ${NOTE_NAMES[pc]}${4}`}
                  >
                    <span>{NOTE_NAMES[pc]}</span>
                    <small>{["Z", "X", "C", "V", "B", "N", "M"][i]}</small>
                  </button>
                ),
              )
            }
            {
              BLACK_KEYS.map((key, i) => (
                <button
                  type="button"
                  class="ch-key ch-key-black"
                  data-midi={60 + key.pc}
                  style={`left:${(key.after + 1) * whiteWidth - 4}%;width:8%`}
                  aria-label={`Tocar ${NOTE_NAMES[key.pc]}${4} (tecla ${["S", "D", "G", "H", "J"][i]})`}
                >
                  <small>{["S", "D", "G", "H", "J"][i]}</small>
                </button>
              ))
            }
          </div>
        </div>
        <p class="ch-detected" id="ch-detected" aria-live="polite"></p>

        <div class="ch-mic-box" id="ch-mic-box" hidden>
          <button type="button" class="ch-mic-btn" id="ch-mic-btn">🎤 Activar micrófono</button>
          <div class="ch-signal" aria-hidden="true"><i id="ch-signal-bar"></i></div>
          <p class="ch-confidence" id="ch-confidence">Señal: —</p>
          <p class="ch-privacy">
            🔒 El audio se analiza en tu dispositivo: no se graba ni sale del navegador.
          </p>
        </div>
        <button type="button" class="ch-midi-btn" id="ch-midi-btn" hidden>
          🎹 Conectar MIDI
        </button>
      </div>

      <div class="ch-feedback" id="ch-feedback" role="status" aria-live="polite" hidden></div>

      <div class="ch-footer">
        <button type="button" class="ch-hint-btn" id="ch-hint" hidden>💡 Ver pista</button>
        <button type="button" class="ch-next-btn" id="ch-next" hidden>
          Siguiente reto <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div class="ch-summary" id="ch-summary" hidden>
      <div class="ch-summary-icon" aria-hidden="true">✨</div>
      <h2 id="ch-summary-title">¡Sesión terminada!</h2>
      <p id="ch-summary-text"></p>
      <button type="button" class="ch-next-btn" id="ch-close">Seguir explorando</button>
    </div>
  </section>
</div>

<style is:global>
  .challenge-session[hidden],
  .challenge-session [hidden] {
    display: none !important;
  }

  .challenge-session {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: max(10px, env(safe-area-inset-top)) max(10px, env(safe-area-inset-right))
      max(10px, env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left));
    overflow: hidden;
    font-family: Inter, system-ui, sans-serif;
  }

  .challenge-session .ch-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(4 4 9 / 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .challenge-session .ch-shell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: min(760px, 100%);
    max-height: 100%;
    padding: clamp(14px, 2.4vw, 22px);
    overflow: hidden;
    border: 1px solid var(--bd-strong);
    border-radius: 26px;
    background: color-mix(in srgb, var(--card-strong) 78%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
  }

  .challenge-session .ch-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .challenge-session .ch-identity {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .challenge-session .ch-logo {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 13px;
    background: linear-gradient(135deg, var(--acc), #ec4899);
    color: #fff;
    font-size: 1.2rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }

  .challenge-session .ch-identity-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }

  .challenge-session .ch-kicker {
    color: var(--acc);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .challenge-session #ch-step-label {
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .challenge-session .ch-progress {
    display: flex;
    flex: 1 1 auto;
    gap: 5px;
    min-width: 90px;
  }

  .challenge-session .ch-seg {
    flex: 1 1 0;
    height: 7px;
    border-radius: 999px;
    background: var(--bd);
    transition: background 0.35s ease, transform 0.35s ease;
  }

  .challenge-session .ch-seg.is-done {
    background: linear-gradient(90deg, var(--acc), #fb7185);
  }

  .challenge-session .ch-seg.is-current {
    background: var(--tool);
    transform: scaleY(1.45);
  }

  .challenge-session .ch-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }

  .challenge-session .ch-icon-btn {
    width: 44px;
    height: 44px;
    border: 1px solid var(--bd);
    border-radius: 13px;
    background: var(--card);
    color: var(--mut);
    font-size: 1.1rem;
    cursor: pointer;
    transition: transform 0.12s ease, border-color 0.2s, color 0.2s;
  }

  .challenge-session .ch-icon-btn:hover,
  .challenge-session .ch-icon-btn[aria-pressed="true"] {
    border-color: var(--acc);
    color: var(--acc);
  }

  .challenge-session .ch-icon-btn:active {
    transform: scale(0.93);
  }

  .challenge-session .ch-exit {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--bd-strong);
    border-radius: 13px;
    background: var(--bg-2);
    color: var(--fg);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.12s;
  }

  .challenge-session .ch-exit:hover {
    border-color: var(--acc);
  }

  .challenge-session .ch-exit:active {
    transform: scale(0.97);
  }

  .challenge-session .ch-settings {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    padding: 10px 14px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px var(--bd);
    background: var(--card);
  }

  .challenge-session .ch-setting {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--mut);
    cursor: pointer;
  }

  .challenge-session .ch-setting input[type="checkbox"] {
    width: 20px;
    height: 20px;
    accent-color: var(--acc);
  }

  .challenge-session .ch-setting-select {
    gap: 8px;
  }

  .challenge-session .ch-setting select {
    min-height: 38px;
    padding: 6px 10px;
    border: 1px solid var(--bd);
    border-radius: 10px;
    background: var(--bg-2);
    color: var(--fg);
    font: inherit;
    font-size: 0.82rem;
  }

  .challenge-session .ch-stage,
  .challenge-session .ch-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-height: 0;
    overflow-y: auto;
    text-align: center;
    padding: 4px 2px 2px;
  }

  .challenge-session .ch-kind {
    margin: 0;
    color: var(--tool);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .challenge-session .ch-question {
    margin: 0;
    font: 700 clamp(1.25rem, 3.6vw, 2rem) / 1.2 Georgia, "Times New Roman", serif;
    text-wrap: balance;
  }

  .challenge-session .ch-sub {
    margin: -4px 0 0;
    color: var(--mut);
    font-size: 0.85rem;
  }

  .challenge-session .ch-replay {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    margin-top: 2px;
    padding: 10px 22px;
    border: 1px solid color-mix(in srgb, var(--tool) 45%, var(--bd));
    border-radius: 999px;
    background: var(--tool2);
    color: var(--fg);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.12s ease, border-color 0.2s, background 0.2s, color 0.2s;
  }

  .challenge-session .ch-replay:hover {
    border-color: var(--tool);
    background: color-mix(in srgb, var(--tool) 22%, var(--card));
  }

  .challenge-session .ch-replay:active {
    transform: scale(0.97);
  }

  .challenge-session .ch-replay.is-playing {
    border-color: var(--tool);
    color: var(--tool);
  }

  .challenge-session .ch-replay:focus-visible {
    outline: 2px solid var(--tool);
    outline-offset: 3px;
  }

  .challenge-session .ch-pulse {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin-top: auto;
    padding: 12px;
    border-radius: 18px;
    box-shadow: inset 0 0 0 1px var(--bd);
    background: var(--card);
  }

  .challenge-session .ch-pulse-dots {
    display: flex;
    gap: 10px;
  }

  .challenge-session .ch-pulse-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--bg-2);
    box-shadow: inset 0 0 0 2px var(--bd);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .challenge-session .ch-pulse-dot.is-next {
    box-shadow: 0 0 0 3px var(--tool2), inset 0 0 0 2px var(--tool);
    transform: scale(1.15);
  }

  .challenge-session .ch-pulse-dot.is-hit {
    background: var(--ok);
    box-shadow: 0 0 12px color-mix(in srgb, var(--ok) 55%, transparent);
  }

  .challenge-session .ch-pulse-dot.is-miss {
    background: var(--tool);
    opacity: 0.6;
  }

  .challenge-session .ch-pulse-status {
    margin: 0;
    color: var(--mut);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .challenge-session .ch-pulse-tap {
    width: min(100%, 340px);
    min-height: 76px;
    border: 0;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--tool), #38bdf8);
    color: #04121a;
    font: inherit;
    font-size: 1.05rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 10px 24px color-mix(in srgb, var(--tool) 28%, transparent);
    transition: transform 0.12s, filter 0.2s;
  }

  .challenge-session .ch-pulse-tap small {
    display: block;
    margin-top: 2px;
    font-size: 0.66rem;
    opacity: 0.75;
  }

  .challenge-session .ch-pulse-tap:hover {
    filter: brightness(1.08);
  }

  .challenge-session .ch-pulse-tap:active {
    transform: scale(0.96);
  }

  .challenge-session .ch-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin-top: auto;
  }

  .challenge-session .ch-opt {
    min-height: 68px;
    padding: 14px 18px;
    border: 1px solid var(--bd-strong);
    border-radius: 18px;
    background: var(--card);
    color: var(--fg);
    font: inherit;
    font-size: 1.02rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.12s ease, border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .challenge-session .ch-opt:hover {
    border-color: var(--acc);
    background: var(--acc2);
    transform: translateY(-2px);
  }

  .challenge-session .ch-opt:active {
    transform: scale(0.97);
  }

  .challenge-session .ch-opt.is-picked {
    border-color: var(--tool);
    box-shadow: 0 0 0 3px var(--tool2);
  }

  .challenge-session .ch-play {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin-top: auto;
  }

  .challenge-session .ch-target {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .challenge-session .ch-keys-scroll {
    width: 100%;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .challenge-session .ch-keys {
    position: relative;
    width: 100%;
    min-width: 420px;
    height: 132px;
  }

  .challenge-session .ch-key {
    position: absolute;
    top: 0;
    cursor: pointer;
    font: inherit;
    transition: filter 0.1s, transform 0.1s;
  }

  .challenge-session .ch-key-white {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    padding-bottom: 12px;
    border: 1px solid rgb(0 0 0 / 0.35);
    border-radius: 0 0 10px 10px;
    background: linear-gradient(180deg, #fff, #dbe3ec);
    color: #0f172a;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .challenge-session .ch-key-white small {
    color: #64748b;
    font-size: 0.62rem;
  }

  .challenge-session .ch-key-black {
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 62%;
    padding-bottom: 8px;
    border: 1px solid rgb(0 0 0 / 0.7);
    border-radius: 0 0 8px 8px;
    background: linear-gradient(180deg, #26262e, #050507);
  }

  .challenge-session .ch-key-black small {
    color: #cbd5e1;
    font-size: 0.6rem;
    font-weight: 800;
  }

  .challenge-session .ch-key.is-down {
    filter: brightness(1.35) saturate(1.4);
    transform: translateY(2px);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--acc) 55%, transparent);
  }

  .challenge-session .ch-detected {
    min-height: 1.4em;
    margin: 0;
    color: var(--mut);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .challenge-session .ch-mic-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 12px;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--bd);
    background: var(--card);
  }

  .challenge-session .ch-mic-btn,
  .challenge-session .ch-midi-btn {
    min-height: 48px;
    padding: 10px 22px;
    border: 0;
    border-radius: 14px;
    background: var(--tool);
    color: #04121a;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.12s, filter 0.2s;
  }

  .challenge-session .ch-mic-btn:hover,
  .challenge-session .ch-midi-btn:hover {
    filter: brightness(1.08);
  }

  .challenge-session .ch-mic-btn:active,
  .challenge-session .ch-midi-btn:active {
    transform: scale(0.97);
  }

  .challenge-session .ch-signal {
    width: min(100%, 320px);
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--bd);
  }

  .challenge-session .ch-signal i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--tool);
    transition: width 0.08s linear;
  }

  .challenge-session .ch-confidence {
    margin: 0;
    color: var(--mut);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .challenge-session .ch-privacy {
    margin: 0;
    color: var(--mut);
    font-size: 0.72rem;
  }

  .challenge-session .ch-feedback {
    position: relative;
    width: 100%;
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 0.92rem;
    line-height: 1.4;
    animation: ch-pop 0.28s ease-out;
  }

  .challenge-session .ch-feedback strong {
    display: block;
    margin-bottom: 2px;
    font-size: 1rem;
  }

  .challenge-session .ch-feedback span {
    color: var(--mut);
  }

  .challenge-session .ch-feedback.is-good {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ok) 55%, var(--bd));
    background: var(--ok2);
    color: var(--ok);
  }

  .challenge-session .ch-feedback.is-good::after {
    content: "✦  ✧  ✦";
    position: absolute;
    top: -8px;
    right: 12px;
    color: var(--acc);
    letter-spacing: 0.4em;
    animation: ch-spark 0.9s ease-out both;
    pointer-events: none;
  }

  .challenge-session .ch-feedback.is-close {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tool) 45%, var(--bd));
    background: var(--tool2);
    color: var(--fg);
  }

  .challenge-session .ch-footer {
    display: flex;
    justify-content: center;
    gap: 12px;
    width: 100%;
    min-height: 56px;
  }

  .challenge-session .ch-hint-btn {
    min-height: 56px;
    padding: 10px 20px;
    border: 1px solid var(--bd-strong);
    border-radius: 16px;
    background: var(--card);
    color: var(--fg);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .challenge-session .ch-next-btn {
    min-height: 56px;
    padding: 12px 30px;
    border: 0;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--acc), #fb7185);
    color: #160c04;
    font: inherit;
    font-size: 1.02rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 10px 24px color-mix(in srgb, var(--acc) 28%, transparent);
    transition: transform 0.12s, filter 0.2s;
  }

  .challenge-session .ch-next-btn:hover {
    filter: brightness(1.06);
  }

  .challenge-session .ch-next-btn:active {
    transform: scale(0.97);
  }

  .challenge-session .ch-summary {
    padding: 24px 0;
  }

  .challenge-session .ch-summary-icon {
    font-size: 3rem;
  }

  .challenge-session .ch-summary h2 {
    margin: 0;
    font: 700 clamp(1.4rem, 4vw, 2rem) / 1.2 Georgia, "Times New Roman", serif;
  }

  .challenge-session .ch-summary p {
    max-width: 46ch;
    margin: 0 0 8px;
