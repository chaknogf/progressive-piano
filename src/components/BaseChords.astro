---
import { BASE_CHORDS } from '../data/chords';
---
<div class="grid" id="base"></div>
<script>
  import { BASE_CHORDS } from '../data/chords';
  import { displayNote } from '../lib/theory';
  import { renderChordView } from '../lib/views';
  import { must } from '../lib/dom';

  const grid = must(document.getElementById('base'), '#base');
  grid.innerHTML = BASE_CHORDS.map(
    (item) => `
      <div class="cd">
        <span class="tg">Grado ${item.degree} · ${item.name}</span>
        <h3>${displayNote(item.chord)}</h3>
        <div class="v"></div>
      </div>`,
  ).join('');

  grid.querySelectorAll<HTMLElement>('.cd').forEach((card, index) => {
    const target = card.querySelector('.v');
    if (target) renderChordView(target, BASE_CHORDS[index].chord);
  });
</script>
