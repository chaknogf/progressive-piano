---
// Teclado de una octava que muestra el nombre y la octava de cada tecla.
---
<section class="box" aria-labelledby="nnk-title">
  <h3 id="nnk-title">Teclado con nombres de nota</h3>
  <p class="mut">Pulsa una tecla: oirás la nota y verás su nombre y su octava. Cambia la octava con el selector.</p>
  <div style="display:flex;gap:10px;align-items:center;margin:8px 0;">
    <label>Octava <select id="nnk-oct"></select></label>
    <span id="nnk-info" style="font-weight:700;">—</span>
  </div>
  <div id="nnk-kb" style="position:relative;height:90px;background:var(--bg);border:1px solid var(--bd);border-radius:8px;overflow:hidden;"></div>
</section>

<script>
  import { playNote as pianoNote } from "../lib/piano-engine";
  const NAMES = ["Do","Do♯","Re","Re♯","Mi","Fa","Fa♯","Sol","Sol♯","La","La♯","Si"];
  const whiteIdx = [0,2,4,5,7,9,11];
  const blackIdx = [1,3,6,8,10];
  const kb = document.getElementById("nnk-kb") as HTMLElement;
  const info = document.getElementById("nnk-info") as HTMLElement;
  const octSel = document.getElementById("nnk-oct") as HTMLSelectElement;
  for (let o = 2; o <= 6; o++) octSel.add(new Option(String(o), String(o)));
  octSel.value = "4";
  function midiOf(pc: number, oct: number) { return pc + (oct + 1) * 12; }
  function build() {
    kb.innerHTML = "";
    const oct = parseInt(octSel.value, 10);
    whiteIdx.forEach((pc, i) => {
      const el = document.createElement("div");
      el.style.cssText = `position:absolute;bottom:0;left:${(i/7)*100}%;width:${100/7}%;height:100%;background:#fff;border:1px solid #999;border-radius:0 0 4px 4px;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:4px;font-size:0.7rem;color:#333;cursor:pointer;`;
      el.innerHTML = `<span style="font-weight:700;">${NAMES[pc]}</span><span style="font-size:0.6rem;color:#888;">${oct}</span>`;
      el.addEventListener("click", () => {
        const m = midiOf(pc, oct);
        play(m);
        info.textContent = `${NAMES[pc]}${oct} (MIDI ${m})`;
      });
      kb.appendChild(el);
    });
    blackIdx.forEach((pc) => {
      const whitesBefore = whiteIdx.filter((w) => w < pc).length;
      const el = document.createElement("div");
      el.style.cssText = `position:absolute;bottom:35%;left:${(whitesBefore/7)*100 - 1.8}%;width:3.6%;height:65%;background:#222;border-radius:0 0 3px 3px;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:3px;font-size:0.6rem;color:#fff;cursor:pointer;`;
      el.innerHTML = `<span style="font-weight:700;">${NAMES[pc]}</span>`;
      el.addEventListener("click", () => {
        const m = midiOf(pc, oct);
        play(m);
        info.textContent = `${NAMES[pc]}${oct} (MIDI ${m})`;
      });
      kb.appendChild(el);
    });
  }
  function play(m: number) {
    pianoNote(m, 0.6);
  }
  octSel.addEventListener("change", build);
  build();
</script>
---
