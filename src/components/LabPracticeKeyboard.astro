  function scheduleChordHighlights(): void {
    clearChordHighlights();
    if (view === "melody") return;
    const beatMs = (60 / bpm) * 1000;
    const delayMs = START_DELAY * 1000;
    for (const chord of activeMelody.chords) {
      const voicing = buildVoicing(chord, activeMelody);
      const startMs = (chord.beat - 1) * beatMs + delayMs;
      const endMs = (chord.beat - 1 + chord.duration) * beatMs + delayMs;
      chordTimers.push(
        window.setTimeout(() => {
          chordEl.textContent = voicing.name;
          $$(".mk-key", keysEl).forEach((key) => {
            if (voicing.all.includes(Number(key.dataset.midi)))
              key.classList.add("is-chord");
          });
        }, startMs),
      );
      chordTimers.push(
        window.setTimeout(() => {
          $$(".mk-key", keysEl).forEach((key) => {
            if (voicing.all.includes(Number(key.dataset.midi)))
              key.classList.remove("is-chord");
          });
        }, endMs),
      );
    }
  }

  function onNote(index: number): void {
    const event = melodyEvents[index];
    if (!event) return;
    setNote(event.midi);
    window.clearTimeout(highlightTimer);
    highlightTimer = window.setTimeout(
      () => setNote(null),
      event.dur * (60 / bpm) * 1000,
    );
    const meter = activeMelody.meter;
    beatEl.textContent = `Compás ${Math.floor(event.start / meter) + 1} · tiempo ${Math.floor(event.start % meter) + 1}`;
  }

  function tick(): void {
    if (!playing) return;
    const elapsed = Math.max(0, (performance.now() - startTime) / 1000);
    const beat = elapsed * (bpm / 60);
    progressBar.style.width = `${Math.min(100, (beat / totalBeats) * 100)}%`;
    rafId = requestAnimationFrame(tick);
  }

  function onEnd(): void {
    playing = false;
    cancelPlayback = null;
    cancelAnimationFrame(rafId);
    playButton.setAttribute("aria-pressed", "false");
    playButton.textContent = "▶ Reproducir";
    setNote(null);
    chordEl.textContent = "—";
    clearChordHighlights();
    beatEl.textContent = "Compás 1";
    progressBar.style.width = "0%";
  }

  function play(): void {
    if (playing) return;
    playing = true;
    playButton.setAttribute("aria-pressed", "true");
    playButton.textContent = "■ Detener";
    startTime = performance.now() + START_DELAY * 1000;
    cancelPlayback = playPiano(events, bpm, { onNote, onEnd });
    scheduleChordHighlights();
    rafId = requestAnimationFrame(tick);
  }

  function stop(): void {
    if (!playing) return;
    cancelPlayback?.();
  }

  playButton.addEventListener("click", () => (playing ? stop() : play()));
  restartButton.addEventListener("click", () => {
    if (playing) cancelPlayback?.();
    window.setTimeout(play, 30);
  });
  bpmInput.addEventListener("input", () => {
    bpm = Number(bpmInput.value);
    bpmValue.textContent = String(bpm);
    if (playing) {
      cancelPlayback?.();
      window.setTimeout(play, 30);
    }
  });
  melodySelect.addEventListener("change", () => {
    if (playing) cancelPlayback?.();
    bpm = (MELODIES[melodySelect.value] ?? MELODIES["melody-1"]).bpm;
    syncTempoUi();
    buildTrack();
    beatEl.textContent = "Compás 1";
  });
  viewButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const nextView = (button.dataset.view ?? "both") as ViewMode;
      if (nextView === view) return;
      const wasPlaying = playing;
      if (wasPlaying) cancelPlayback?.();
      view = nextView;
      viewButtons.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === button)),
      );
      buildTrack();
      beatEl.textContent = "Compás 1";
      if (wasPlaying) window.setTimeout(play, 30);
    });
  });

  function triggerKey(event: Event): void {
    const key = (event.target as HTMLElement).closest<HTMLButtonElement>(
      ".mk-key",
    );
    if (!key) return;
    const midi = Number(key.dataset.midi);
    playNote(midi, 1.1);
    setNote(midi);
    window.dispatchEvent(new CustomEvent('note-played', { detail: { midi, source: 'keyboard' } }));
    window.clearTimeout(highlightTimer);
    highlightTimer = window.setTimeout(() => setNote(null), 500);
  }

  let lastPointerDown = 0;
  keysEl.addEventListener("pointerdown", (event) => {
    lastPointerDown = Date.now();
    triggerKey(event);
  });
  // Los botones también se activan con Enter/Espacio: el clic de teclado no
  // debe duplicar la pulsación por puntero.
  keysEl.addEventListener("click", (event) => {
    if (Date.now() - lastPointerDown < 500) return;
    triggerKey(event);
  });
  document.addEventListener("visibilitychange", () => {
    if (document.hidden && playing) stop();
  });

  // --- Práctica QWERTY (2 octavas), sustain y indicador de notas/acordes ---
  const LOW_MAP: Record<string, number> = { KeyZ:0, KeyS:1, KeyX:2, KeyD:3, KeyC:4, KeyV:5, KeyG:6, KeyB:7, KeyH:8, KeyN:9, KeyJ:10, KeyM:11 };
  const HIGH_MAP: Record<string, number> = { KeyQ:0, Digit2:1, KeyW:2, Digit3:3, KeyE:4, KeyR:5, Digit5:6, KeyT:7, Digit6:8, KeyY:9, Digit7:10, KeyU:11, KeyI:12, Digit9:13, KeyO:14, Digit0:15, KeyP:16 };
  const CODE_LABEL: Record<string, string> = { KeyZ:'Z',KeyS:'S',KeyX:'X',KeyD:'D',KeyC:'C',KeyV:'V',KeyG:'G',KeyB:'B',KeyH:'H',KeyN:'N',KeyJ:'J',KeyM:'M', KeyQ:'Q',Digit2:'2',KeyW:'W',Digit3:'3',KeyE:'E',KeyR:'R',Digit5:'5',KeyT:'T',Digit6:'6',KeyY:'Y',Digit7:'7',KeyU:'U',KeyI:'I',Digit9:'9',KeyO:'O',Digit0:'0',KeyP:'P' };
  let baseOctave = 4; // Do4 base para octava baja (Z-M), alta = baseOctave+1
  let showQwerty = true;
  let sustainDown = false;
  const pressedCodes = new Set<string>(); // evita autorepetición
  const userActiveMidis = new Set<number>(); // notas activas por usuario

  function midiForCode(code: string): number | null {
    if (code in LOW_MAP) return (baseOctave + 1) * 12 + LOW_MAP[code];
    if (code in HIGH_MAP) return (baseOctave + 2) * 12 + HIGH_MAP[code];
    return null;
  }
  function isTypingTarget(el: EventTarget | null): boolean {
    const t = el as HTMLElement | null;
    if (!t) return false;
    const tag = t.tagName;
    return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || t.isContentEditable;
  }
  function updateOctaveUi(): void {
    octaveEl.textContent = `${baseOctave}–${baseOctave + 1}`;
    refreshQwertyLabels();
  }
  function refreshQwertyLabels(): void {
    const byMidi = new Map<number, string[]>();
    if (showQwerty) {
      for (const [code, semi] of Object.entries(LOW_MAP)) {
        const m = (baseOctave + 1) * 12 + semi;
        const arr = byMidi.get(m) ?? []; arr.push(CODE_LABEL[code]); byMidi.set(m, arr);
      }
      for (const [code, semi] of Object.entries(HIGH_MAP)) {
        const m = (baseOctave + 2) * 12 + semi;
        const arr = byMidi.get(m) ?? []; arr.push(CODE_LABEL[code]); byMidi.set(m, arr);
      }
    }
    $$('.mk-key', keysEl).forEach((key) => {
      const midi = Number(key.dataset.midi);
      const lbl = key.querySelector<HTMLElement>('.mk-key-qwerty');
      const labels = byMidi.get(midi);
      if (lbl) lbl.textContent = labels ? labels.join('/') : '';
      key.classList.toggle('has-qwerty', Boolean(labels && labels.length));
    });
  }
  function setUserKeyVisual(midi: number, on: boolean): void {
    $$('.mk-key', keysEl).forEach((key) => {
      if (Number(key.dataset.midi) === midi) key.classList.toggle('is-user', on);
    });
  }
  function notePcName(midi: number): string { return fullLabel(midi); }
  function detectChordName(midis: number[]): string {
    if (midis.length < 2) return '—';
    const pcs = [...new Set(midis.map(m => ((m % 12) + 12) % 12))].sort((a,b)=>a-b);
    const names = ["Do","Do♯","Re","Re♯","Mi","Fa","Fa♯","Sol","Sol♯","La","La♯","Si"];
    const patterns: Array<[string, number[]]> = [
      ['maj7',[0,4,7,11]],['7',[0,4,7,10]],['m7',[0,3,7,10]],['mMaj7',[0,3,7,11]],['m7b5',[0,3,6,10]],['dim7',[0,3,6,9]],
      ['m',[0,3,7]],['',[0,4,7]],['dim',[0,3,6]],['aug',[0,4,8]],['sus4',[0,5,7]],['sus2',[0,2,7]],['5',[0,7]]
    ];
    const bassPc = ((Math.min(...midis) % 12) + 12) % 12;
    const roots = [bassPc, ...pcs.filter(p=>p!==bassPc)];
    for (const root of roots) {
      const rel = pcs.map(p => (p - root + 12) % 12).sort((a,b)=>a-b).join(',');
      for (const [qual, ints] of patterns) {
        if (ints.slice().sort((a,b)=>a-b).join(',') === rel) {
          const slash = root !== bassPc ? `/${names[bassPc]}` : '';
          return `${names[root]}${qual}${slash}`;
        }
      }
    }
    return '—';
  }
  function updateLiveIndicator(): void {
    const midis = [...userActiveMidis].sort((a,b)=>a-b);
    liveNotesEl.textContent = midis.length ? midis.map(notePcName).join(', ') : '—';
    liveChordEl.textContent = detectChordName(midis);
  }
  function userNoteOn(midi: number): void {
    if (midi < 36 || midi > 88) return;
    if (userActiveMidis.has(midi)) { noteOff(midi); }
    userActiveMidis.add(midi);
    noteOn(midi, 0.85);
    setUserKeyVisual(midi, true);
    setNote(midi);
    window.dispatchEvent(new CustomEvent('note-played', { detail: { midi, source: 'qwerty' } }));
    updateLiveIndicator();
  }
  function userNoteOff(midi: number): void {
    if (!userActiveMidis.has(midi)) return;
    userActiveMidis.delete(midi);
    noteOff(midi);
    // si el pedal está abajo mantenemos visual mientras suene? simplificamos: quitamos visual al soltar tecla física salvo que queramos sostener; mejor quitar is-user al soltar tecla y dejar sonido al pedal
    setUserKeyVisual(midi, false);
    if (userActiveMidis.size === 0) setNote(null);
    else setNote([...userActiveMidis].sort((a,b)=>a-b).at(-1) ?? null);
    updateLiveIndicator();
  }
  function changeOctave(delta: number): void {
    baseOctave = Math.max(1, Math.min(6, baseOctave + delta));
    updateOctaveUi();
  }

  octDownBtn.addEventListener('click', () => changeOctave(-1));
  octUpBtn.addEventListener('click', () => changeOctave(1));
  qwertyLabelsBtn.addEventListener('click', () => {
    showQwerty = !showQwerty;
    qwertyLabelsBtn.setAttribute('aria-pressed', String(showQwerty));
    refreshQwertyLabels();
  });
  document.addEventListener('keydown', (e) => {
    if (isTypingTarget(e.target)) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.code === 'Space') {
      e.preventDefault();
      if (e.repeat) return;
      sustainDown = true; setSustainPedal(true);
      pedalEl.textContent = 'Sustain: ON (Espacio)';
      pedalEl.classList.add('on');
      return;
    }
    if (e.code === 'Equal' || e.code === 'NumpadAdd') { e.preventDefault(); if (!e.repeat) changeOctave(1); return; }
    if (e.code === 'Minus' || e.code === 'NumpadSubtract') { e.preventDefault(); if (!e.repeat) changeOctave(-1); return; }
    const midi = midiForCode(e.code);
    if (midi == null) return;
    e.preventDefault();
    if (pressedCodes.has(e.code) || e.repeat) return;
    pressedCodes.add(e.code);
    userNoteOn(midi);
  });
  document.addEventListener('keyup', (e) => {
    if (e.code === 'Space') {
      sustainDown = false; setSustainPedal(false);
      pedalEl.textContent = 'Sustain: OFF (Espacio)';
      pedalEl.classList.remove('on');
      // al soltar pedal, notas ya no pulsadas deben perder visual
      $$('.mk-key.is-user', keysEl).forEach((key) => {
        const m = Number(key.dataset.midi);
        if (!userActiveMidis.has(m)) key.classList.remove('is-user');
      });
      return;
    }
    const midi = midiForCode(e.code);
    if (midi == null) return;
    if (!pressedCodes.has(e.code)) return;
    pressedCodes.delete(e.code);
    userNoteOff(midi);
  });
  window.addEventListener('blur', () => {
    // soltar todo al perder foco
    [...userActiveMidis].forEach(m => { userActiveMidis.delete(m); noteOff(m); setUserKeyVisual(m,false); });
    pressedCodes.clear();
    setSustainPedal(false); sustainDown = false;
    pedalEl.textContent = 'Sustain: OFF (Espacio)'; pedalEl.classList.remove('on');
    updateLiveIndicator(); setNote(null);
  });

  updateOctaveUi();
  refreshQwertyLabels();

  syncTempoUi();
  buildTrack();
</script>

