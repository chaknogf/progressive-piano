    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 2px 3px rgb(0 0 0 / 0.45);
  }
  .mk-key-label {
    color: var(--mut);
    font-size: 0.6rem;
    font-weight: 700;
    pointer-events: none;
  }
  .mk-key--black .mk-key-label {
    display: none;
  }
  .mk-key--white.is-active {
    background: linear-gradient(
