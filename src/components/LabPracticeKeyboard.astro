---
// src/components/MelodyKeyboard.astro
// Teclado de cuatro octavas que reproduce la melodía y ilumina cada tecla.
const WHITE_PITCHES = [0, 2, 4, 5, 7, 9, 11];
const BLACK_PITCHES = [1, 3, 6, 8, 10];
const FIRST_MIDI = 36; // Do2
const LAST_MIDI = 88; // Mi6
const ALL_MIDIS = Array.from(
  { length: LAST_MIDI - FIRST_MIDI + 1 },
  (_, index) => FIRST_MIDI + index,
);
const WHITE_KEYS = ALL_MIDIS.filter((midi) =>
  WHITE_PITCHES.includes(midi % 12),
);
const BLACK_WIDTH = 2.1;
// Posición horizontal de cada tecla negra, medida desde el total de teclas blancas.
const BLACK_KEYS = ALL_MIDIS.filter((midi) =>
  BLACK_PITCHES.includes(midi % 12),
).map((midi) => {
  const whitesBefore = WHITE_KEYS.filter((white) => white < midi).length;
  return {
    midi,
    left: (whitesBefore / WHITE_KEYS.length) * 100 - BLACK_WIDTH / 2,
  };
});
const NOTE_NAMES = [
  "Do",
  "Do♯",
  "Re",
  "Re♯",
  "Mi",
  "Fa",
  "Fa♯",
  "Sol",
  "Sol♯",
  "La",
  "La♯",
  "Si",
];
function keyLabel(midi: number): string {
  return NOTE_NAMES[midi % 12];
}
function fullLabel(midi: number): string {
  return `${NOTE_NAMES[midi % 12]}${Math.floor(midi / 12) - 1}`;
}
// Mapeo QWERTY (letras mostradas sobre teclas cuando baseOctave coincide)
const QWERTY_LOW: Record<string, number> = { KeyZ:0, KeyS:1, KeyX:2, KeyD:3, KeyC:4, KeyV:5, KeyG:6, KeyB:7, KeyH:8, KeyN:9, KeyJ:10, KeyM:11 };
const QWERTY_HIGH: Record<string, number> = { KeyQ:0, Digit2:1, KeyW:2, Digit3:3, KeyE:4, KeyR:5, Digit5:6, KeyT:7, Digit6:8, KeyY:9, Digit7:10, KeyU:11, KeyI:12, Digit9:13, KeyO:14, Digit0:15, KeyP:16 };
const QWERTY_LABELS: Record<number, string> = {};
// etiquetas calculadas en runtime, pero preparamos helper
---

<section class="mk" id="lk-root" aria-labelledby="lk-title">
  <header class="mk-head">
    <div class="mk-head-text">
      <span class="mk-kicker">Herramienta de práctica</span>
      <h2 id="lk-title">Teclado de práctica interactivo</h2>
      <p class="mk-sub">
        Practica con dos octavas QWERTY, sustain y visualización de notas y acordes en tiempo real. También puedes reproducir melodías y tocar teclas con el mouse.
      </p>
    </div>
    <div class="mk-transport">
      <label class="mk-melody-select" for="lk-melody">
        Melodía
        <select id="lk-melody">
          <option value="melody-1">Melodía 1 · Sol → Do mayor · 3/4</option>
          <option value="melody-2">Melodía 2 · Do mayor · 4/4</option>
          <option value="melody-3">Melodía 3 · La♭ mayor · 4/4</option>
        </select>
      </label>
      <div class="mk-view" role="group" aria-label="Qué ver y escuchar">
        <button type="button" class="mk-view-btn" data-view="melody" aria-pressed="false">Melodía</button>
        <button type="button" class="mk-view-btn" data-view="chords" aria-pressed="false">Acordes</button>
        <button type="button" class="mk-view-btn" data-view="both" aria-pressed="true">Ambos</button>
      </div>
      <button type="button" class="mk-play" id="lk-play" aria-pressed="false">▶ Reproducir</button>
      <button type="button" class="mk-iconbtn" id="lk-restart" aria-label="Reiniciar melodía">↺</button>
      <label class="mk-tempo">
        Tempo
        <input type="range" id="lk-bpm" min="60" max="180" step="1" value="106" />
        <span id="lk-bpm-value">106</span>
      </label>
      <div class="mk-practice" role="group" aria-label="Práctica con teclado de computadora">
        <span class="mk-practice-label">Octava QWERTY: <b id="lk-octave">4–5</b></span>
        <button type="button" class="mk-iconbtn mk-mini" id="lk-oct-down" aria-label="Bajar octava (tecla -)">−</button>
        <button type="button" class="mk-iconbtn mk-mini" id="lk-oct-up" aria-label="Subir octava (tecla +)">+</button>
        <button type="button" class="mk-view-btn mk-mini" id="lk-qwerty-labels" aria-pressed="true">Teclas QWERTY</button>
        <span class="mk-pedal" id="lk-pedal" aria-live="polite">Sustain: OFF (Espacio)</span>
      </div>
    </div>
  </header>

  <div class="mk-progress" aria-hidden="true">
    <div id="lk-progress-bar"></div>
  </div>

  <div class="mk-status">
    <span class="mk-status-item">Nota: <b id="lk-note">—</b></span>
    <span class="mk-status-item">Acorde: <b id="lk-chord">—</b></span>
    <span class="mk-status-item" id="lk-beat">Compás 1</span>
  </div>
  <div class="mk-live" aria-live="polite">
    <span class="mk-status-item">Notas activas: <b id="lk-live-notes">—</b></span>
    <span class="mk-status-item">Acorde detectado: <b id="lk-live-chord">—</b></span>
  </div>

  <div class="mk-keys-scroll">
    <div
      class="mk-keys"
      id="lk-keys"
      role="group"
      aria-label="Teclado de cuatro octavas"
      style={`--bw: ${BLACK_WIDTH}%`}
    >
      {
        WHITE_KEYS.map((midi) => (
          <button
            type="button"
            class="mk-key mk-key--white"
            data-midi={midi}
            aria-label={fullLabel(midi)}
          >
            <span class="mk-key-label">{keyLabel(midi)}</span>
            <span class="mk-key-qwerty" aria-hidden="true"></span>
          </button>
        ))
      }
      {
        BLACK_KEYS.map((key) => (
          <button
            type="button"
            class="mk-key mk-key--black"
            data-midi={key.midi}
            style={`left: ${key.left}%`}
            aria-label={fullLabel(key.midi)}
          >
            <span class="mk-key-label">{keyLabel(key.midi)}</span>
            <span class="mk-key-qwerty" aria-hidden="true"></span>
          </button>
        ))
      }
    </div>
  </div>

  <p class="mk-hint" id="lk-hint"><span class="mk-leg mk-leg-mel">● Melodía</span> <span class="mk-leg mk-leg-ch">■ Acordes</span> · Toca con el mouse o con tu teclado: <b>Z–M</b> (octava baja), <b>Q–P</b> (octava alta), <b>+/-</b> cambia octavas, <b>Espacio</b> = sustain.</p>
</section>

