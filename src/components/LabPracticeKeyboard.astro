  .mk-key--black {
    position: absolute;
    top: 0;
    z-index: 2;
    width: var(--bw, 2.1%);
    height: 60%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 6px;
    border: 1px solid #0e0b08;
    border-radius: 0 0 6px 6px;
