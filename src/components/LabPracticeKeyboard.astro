  }
  .mk-iconbtn:active {
    transform: scale(0.94);
  }
  .mk-tempo {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--mut);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .mk-tempo input {
    accent-color: var(--acc);
  }
  .mk-progress {
    height: 8px;
    margin: 12px 0 10px;
    border-radius: 999px;
    background: var(--bd);
    overflow: hidden;
  }
  .mk-progress > div {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--acc);
  }
  .mk-status {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 12px;
    color: var(--mut);
    font-size: 0.85rem;
  }
  .mk-status-item b {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  /* El teclado tiene 4 octavas: en pantallas estrechas se desplaza en horizontal. */
  .mk-keys-scroll {
    overflow-x: auto;
    border-radius: 16px;
    -webkit-overflow-scrolling: touch;
  }
  .mk-keys {
    position: relative;
    display: flex;
    min-width: 860px;
    height: clamp(160px, 24vw, 240px);
    border: 1px solid var(--bd);
    border-radius: 16px;
    overflow: hidden;
    background: var(--bk);
    box-shadow: inset 0 2px 8px rgb(0 0 0 / 0.45);
