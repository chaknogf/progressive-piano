  .mk-live { display:flex; flex-wrap:wrap; gap:6px 16px; margin: 4px 0 10px; color: var(--mut); font-size: .85rem; }
  .mk-practice { display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:6px 8px; border:1px dashed var(--bd); border-radius:12px; }
  .mk-practice-label { font-size:.78rem; color:var(--mut); }
  .mk-mini { min-height:34px; height:34px; padding:4px 10px; font-size:.78rem; }
