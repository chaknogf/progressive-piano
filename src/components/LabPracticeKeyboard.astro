  .mk-key.is-user.mk-key--white .mk-key-label, .mk-key.is-user.mk-key--white .mk-key-qwerty { color:#111; }
  .mk-key.is-user.mk-key--black { background: linear-gradient(180deg, #f59e0b, #b45309) !important; box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.6); }
  @media (max-width: 520px) {
    .mk {
