---
/**
 * Teclado de práctica interactivo (Laboratorio).
 * Herramienta nueva: QWERTY, sustain, indicador de notas/acordes (sin reproducción de melodías).
 */
const WHITE_PITCHES = [0, 2, 4, 5, 7, 9, 11];
const BLACK_PITCHES = [1, 3, 6, 8, 10];
const FIRST_MIDI = 36; // Do2
const LAST_MIDI = 84; // Do6 (4 octavas visibles)
const ALL_MIDIS = Array.from({ length: LAST_MIDI - FIRST_MIDI + 1 }, (_, i) => FIRST_MIDI + i);
const WHITE_KEYS = ALL_MIDIS.filter((midi) => WHITE_PITCHES.includes(midi % 12));
const BLACK_WIDTH = 3.2;
const BLACK_KEYS = ALL_MIDIS.filter((midi) => BLACK_PITCHES.includes(midi % 12)).map((midi) => {
  const whitesBefore = WHITE_KEYS.filter((w) => w < midi).length;
  return { midi, left: (whitesBefore / WHITE_KEYS.length) * 100 - BLACK_WIDTH / 2 };
});
const NOTE_NAMES = ["Do", "Do♯", "Re", "Re♯", "Mi", "Fa", "Fa♯", "Sol", "Sol♯", "La", "La♯", "Si"];
function keyLabel(midi: number): string { return NOTE_NAMES[midi % 12]; }
function fullLabel(midi: number): string { return `${NOTE_NAMES[midi % 12]}${Math.floor(midi / 12) - 1}`; }
---

<section class="lk" id="lk-root" aria-labelledby="lk-title" tabindex="-1">
  <header class="lk-head">
    <div>
      <span class="lk-kicker">Herramienta de práctica</span>
      <h2 id="lk-title">Teclado de práctica interactivo</h2>
      <p class="lk-sub">Toca con el mouse o activa el <b>modo concentración</b> para usar el teclado de la computadora. <b>+ / -</b> cambia la octava y <b>Espacio</b> es sustain. <b>Esc</b> sale del modo.</p>
    </div>
    <div class="lk-controls" role="group" aria-label="Controles de práctica">
      <button type="button" class="lk-btn lk-focus" id="lk-focus" aria-pressed="false">Activar modo concentración</button>
      <span class="lk-chip">Octava base: <b id="lk-octave">4</b></span>
      <button type="button" class="lk-btn" id="lk-oct-down" aria-label="Bajar octava">−</button>
      <button type="button" class="lk-btn" id="lk-oct-up" aria-label="Subir octava">+</button>
      <button type="button" class="lk-btn lk-toggle" id="lk-qwerty-labels" aria-pressed="true">Mostrar teclas QWERTY</button>
      <span class="lk-pedal" id="lk-pedal" aria-live="polite">Sustain: OFF (Espacio)</span>
    </div>
  </header>

  <div class="lk-live" aria-live="polite">
    <span>Nota: <b id="lk-note">—</b></span>
    <span>Notas activas: <b id="lk-live-notes">—</b></span>
    <span>Acorde detectado: <b id="lk-live-chord">—</b></span>
  </div>

  <div class="lk-keys-scroll">
    <div class="lk-keys" id="lk-keys" role="group" aria-label="Teclado de piano" style={`--bw: ${BLACK_WIDTH}%`}>
      {WHITE_KEYS.map((midi) => (
        <button type="button" class="lk-key lk-key--white" data-midi={midi} aria-label={fullLabel(midi)}>
          <span class="lk-key-note">{keyLabel(midi)}</span>
          <span class="lk-key-qwerty" aria-hidden="true"></span>
        </button>
      ))}
      {BLACK_KEYS.map((key) => (
        <button type="button" class="lk-key lk-key--black" data-midi={key.midi} style={`left: ${key.left}%`} aria-label={fullLabel(key.midi)}>
          <span class="lk-key-qwerty" aria-hidden="true"></span>
        </button>
      ))}
    </div>
  </div>

  <p class="lk-hint" id="lk-hint">
    Mapeo (en modo concentración): <b>A</b>=Do, <b>W</b>=Do♯, <b>S</b>=Re, <b>E</b>=Re♯, <b>D</b>=Mi, <b>F</b>=Fa, <b>T</b>=Fa♯, <b>G</b>=Sol, <b>Y</b>=Sol♯, <b>H</b>=La, <b>U</b>=La♯, <b>J</b>=Si, <b>K</b>=Do, <b>I</b>=Do♯, <b>L</b>=Re, <b>P</b>=Re♯.
  </p>
</section>

<script>
  import { $$, must } from "../lib/dom";
  import { playNote, noteOn, noteOff, setSustainPedal } from "../lib/piano-engine";

  const root = must(document.querySelector<HTMLElement>("#lk-root"), "#lk-root");
  const keysEl = must(document.querySelector<HTMLElement>("#lk-keys"), "#lk-keys");
  const noteEl = must(document.querySelector<HTMLElement>("#lk-note"), "#lk-note");
  const octaveEl = must(document.querySelector<HTMLElement>("#lk-octave"), "#lk-octave");
  const octDownBtn = must(document.querySelector<HTMLButtonElement>("#lk-oct-down"), "#lk-oct-down");
  const octUpBtn = must(document.querySelector<HTMLButtonElement>("#lk-oct-up"), "#lk-oct-up");
  const qwertyLabelsBtn = must(document.querySelector<HTMLButtonElement>("#lk-qwerty-labels"), "#lk-qwerty-labels");
  const focusBtn = must(document.querySelector<HTMLButtonElement>("#lk-focus"), "#lk-focus");
  const pedalEl = must(document.querySelector<HTMLElement>("#lk-pedal"), "#lk-pedal");
  const liveNotesEl = must(document.querySelector<HTMLElement>("#lk-live-notes"), "#lk-live-notes");
  const liveChordEl = must(document.querySelector<HTMLElement>("#lk-live-chord"), "#lk-live-chord");

  const NOTE_NAMES = ["Do","Do♯","Re","Re♯","Mi","Fa","Fa♯","Sol","Sol♯","La","La♯","Si"];
  const fullLabel = (midi: number): string => `${NOTE_NAMES[midi % 12]}${Math.floor(midi / 12) - 1}`;

  // Mapeo solicitado: C cromático desde Do base
  // do=a, do#=w, re=s, re#=e, mi=d, fa=f, fa#=t, sol=g, sol#=y, la=h, la#=u, si=j, do=k, do#=i, re=l, re#=p
  const QWERTY_MAP: Record<string, number> = {
    KeyA: 0, KeyW: 1, KeyS: 2, KeyE: 3, KeyD: 4, KeyF: 5, KeyT: 6, KeyG: 7, KeyY: 8, KeyH: 9, KeyU: 10, KeyJ: 11, KeyK: 12, KeyI: 13, KeyL: 14, KeyP: 15,
  };
  const CODE_LABEL: Record<string, string> = {
    KeyA:"A", KeyW:"W", KeyS:"S", KeyE:"E", KeyD:"D", KeyF:"F", KeyT:"T", KeyG:"G", KeyY:"Y", KeyH:"H", KeyU:"U", KeyJ:"J", KeyK:"K", KeyI:"I", KeyL:"L", KeyP:"P",
  };

  let baseOctave = 4; // Do base = C4 (MIDI 60)
  let showQwerty = true;
  let practiceMode = false;
  const pressedCodes = new Set<string>();
  const userActiveMidis = new Set<number>();

  function baseMidi(): number { return (baseOctave + 1) * 12; } // C of baseOctave
  function midiForCode(code: string): number | null {
    if (!(code in QWERTY_MAP)) return null;
    return baseMidi() + QWERTY_MAP[code];
  }
  function isTypingTarget(el: EventTarget | null): boolean {
    const t = el as HTMLElement | null;
    if (!t) return false;
    const tag = t.tagName;
    return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || t.isContentEditable;
  }
  function clampMidi(midi: number): boolean { return midi >= 36 && midi <= 96; }

  function refreshQwertyLabels(): void {
    const byMidi = new Map<number, string[]>();
    if (showQwerty) {
      for (const [code, semi] of Object.entries(QWERTY_MAP)) {
        const m = baseMidi() + semi;
        const arr = byMidi.get(m) ?? [];
        arr.push(CODE_LABEL[code]);
        byMidi.set(m, arr);
      }
    }
    $$(".lk-key", keysEl).forEach((key) => {
      const midi = Number(key.dataset.midi);
      const lbl = key.querySelector<HTMLElement>(".lk-key-qwerty");
      const labels = byMidi.get(midi);
      if (lbl) lbl.textContent = labels ? labels.join("/") : "";
      key.classList.toggle("has-qwerty", Boolean(labels && labels.length));
    });
  }

  function setKeyVisual(midi: number, cls: string, on: boolean): void {
    $$(".lk-key", keysEl).forEach((key) => {
      if (Number(key.dataset.midi) === midi) key.classList.toggle(cls, on);
    });
  }

  function setCurrentNote(midi: number | null): void {
    $$(".lk-key", keysEl).forEach((key) => key.classList.toggle("is-active", midi !== null && Number(key.dataset.midi) === midi));
    noteEl.textContent = midi === null ? "—" : fullLabel(midi);
  }

  function detectChordName(midis: number[]): string {
    if (midis.length < 2) return "—";
    const pcs = [...new Set(midis.map((m) => ((m % 12) + 12) % 12))].sort((a, b) => a - b);
    const names = ["Do","Do♯","Re","Re♯","Mi","Fa","Fa♯","Sol","Sol♯","La","La♯","Si"];
    const patterns: Array<[string, number[]]> = [
      ["maj7",[0,4,7,11]],["7",[0,4,7,10]],["m7",[0,3,7,10]],["mMaj7",[0,3,7,11]],["m7b5",[0,3,6,10]],["dim7",[0,3,6,9]],
      ["m",[0,3,7]],["",[0,4,7]],["dim",[0,3,6]],["aug",[0,4,8]],["sus4",[0,5,7]],["sus2",[0,2,7]],["5",[0,7]],
    ];
    const bassPc = ((Math.min(...midis) % 12) + 12) % 12;
    const roots = [bassPc, ...pcs.filter((p) => p !== bassPc)];
    for (const r of roots) {
      const rel = pcs.map((p) => (p - r + 12) % 12).sort((a, b) => a - b).join(",");
      for (const [qual, ints] of patterns) {
        if (ints.slice().sort((a, b) => a - b).join(",") === rel) {
          const slash = r !== bassPc ? `/${names[bassPc]}` : "";
          return `${names[r]}${qual}${slash}`;
        }
      }
    }
    return "—";
  }

  function updateLiveIndicator(): void {
    const midis = [...userActiveMidis].sort((a, b) => a - b);
    liveNotesEl.textContent = midis.length ? midis.map(fullLabel).join(", ") : "—";
    liveChordEl.textContent = detectChordName(midis);
  }

  function userNoteOn(midi: number): void {
    if (!clampMidi(midi)) return;
    if (userActiveMidis.has(midi)) noteOff(midi);
    userActiveMidis.add(midi);
    noteOn(midi, 0.85);
    setKeyVisual(midi, "is-user", true);
    setCurrentNote(midi);
    window.dispatchEvent(new CustomEvent("note-played", { detail: { midi, source: "qwerty" } }));
    updateLiveIndicator();
  }

  function userNoteOff(midi: number): void {
    if (!userActiveMidis.has(midi)) return;
    userActiveMidis.delete(midi);
    noteOff(midi);
    setKeyVisual(midi, "is-user", false);
    if (userActiveMidis.size === 0) setCurrentNote(null);
    else setCurrentNote([...userActiveMidis].sort((a, b) => a - b).at(-1) ?? null);
    updateLiveIndicator();
  }

  function changeOctave(delta: number): void {
    baseOctave = Math.max(1, Math.min(6, baseOctave + delta));
    octaveEl.textContent = String(baseOctave);
    refreshQwertyLabels();
  }

  function releaseAll(): void {
    [...userActiveMidis].forEach((m) => { userActiveMidis.delete(m); noteOff(m); setKeyVisual(m, "is-user", false); });
    pressedCodes.clear();
    setSustainPedal(false);
    pedalEl.textContent = "Sustain: OFF (Espacio)";
    pedalEl.classList.remove("on");
    updateLiveIndicator();
    setCurrentNote(null);
  }

  function setPracticeMode(on: boolean): void {
    practiceMode = on;
    root.classList.toggle("is-focused", on);
    focusBtn.setAttribute("aria-pressed", String(on));
    focusBtn.textContent = on ? "Salir del modo concentración" : "Activar modo concentración";
    if (on) {
      root.focus({ preventScroll: true });
    } else {
      releaseAll();
    }
  }

  // Mouse / touch
  function triggerPointer(event: Event): void {
    const key = (event.target as HTMLElement).closest<HTMLButtonElement>(".lk-key");
    if (!key) return;
    const midi = Number(key.dataset.midi);
    if (!clampMidi(midi)) return;
    playNote(midi, 1.1);
    setCurrentNote(midi);
    window.dispatchEvent(new CustomEvent("note-played", { detail: { midi, source: "keyboard" } }));
  }
  let lastPointerDown = 0;
  keysEl.addEventListener("pointerdown", (e) => {
    if (!practiceMode) setPracticeMode(true);
    lastPointerDown = Date.now();
    triggerPointer(e);
  });
  keysEl.addEventListener("click", (e) => { if (Date.now() - lastPointerDown < 500) return; triggerPointer(e); });
  root.addEventListener("pointerdown", () => { if (!practiceMode) setPracticeMode(true); });

  // Controls
  focusBtn.addEventListener("click", () => setPracticeMode(!practiceMode));
  octDownBtn.addEventListener("click", () => changeOctave(-1));
  octUpBtn.addEventListener("click", () => changeOctave(1));
  qwertyLabelsBtn.addEventListener("click", () => {
    showQwerty = !showQwerty;
    qwertyLabelsBtn.setAttribute("aria-pressed", String(showQwerty));
    qwertyLabelsBtn.textContent = showQwerty ? "Mostrar teclas QWERTY" : "Ocultar teclas QWERTY";
    refreshQwertyLabels();
  });

  function handleKeyDown(e: KeyboardEvent): void {
    if (e.code === "Escape" && practiceMode) {
      e.preventDefault();
      e.stopImmediatePropagation();
      setPracticeMode(false);
      return;
    }
    if (!practiceMode) return;
    if (isTypingTarget(e.target)) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;

    const isControl = e.code === "Space" || e.code === "Equal" || e.code === "NumpadAdd" || e.code === "Minus" || e.code === "NumpadSubtract";
    const midi = midiForCode(e.code);
    if (!isControl && midi == null) return; // teclas no mapeadas: dejar pasar

    // Captura en modo concentración para reducir interferencia de atajos/extensiones
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();

    if (e.code === "Space") {
      if (e.repeat) return;
      setSustainPedal(true);
      pedalEl.textContent = "Sustain: ON (Espacio)";
      pedalEl.classList.add("on");
      return;
    }
    if (e.code === "Equal" || e.code === "NumpadAdd") { if (!e.repeat) changeOctave(1); return; }
    if (e.code === "Minus" || e.code === "NumpadSubtract") { if (!e.repeat) changeOctave(-1); return; }
    if (midi == null) return;
    if (pressedCodes.has(e.code) || e.repeat) return;
    pressedCodes.add(e.code);
    userNoteOn(midi);
  }

  function handleKeyUp(e: KeyboardEvent): void {
    if (!practiceMode) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;

    if (e.code === "Space") {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();
      setSustainPedal(false);
      pedalEl.textContent = "Sustain: OFF (Espacio)";
      pedalEl.classList.remove("on");
      $$(".lk-key.is-user", keysEl).forEach((key) => {
        const m = Number(key.dataset.midi);
        if (!userActiveMidis.has(m)) key.classList.remove("is-user");
      });
      return;
    }
    const midi = midiForCode(e.code);
    if (midi == null) return;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
    if (!pressedCodes.has(e.code)) return;
    pressedCodes.delete(e.code);
    userNoteOff(midi);
  }

  // Captura en fase de captura para priorizar el modo concentración sobre atajos/extensiones cuando sea posible
  window.addEventListener("keydown", handleKeyDown, true);
  window.addEventListener("keyup", handleKeyUp, true);
  root.addEventListener("keydown", handleKeyDown);
  root.addEventListener("keyup", handleKeyUp);

  window.addEventListener("blur", () => {
    releaseAll();
  });

  octaveEl.textContent = String(baseOctave);
  refreshQwertyLabels();
</script>

<style>
  .lk {
    margin: 16px 0 8px;
    padding: 16px;
    border: 1px solid var(--bd);
    border-radius: 18px;
    background: var(--card);
  }
  .lk-head { display: flex; flex-wrap: wrap; gap: 14px 20px; align-items: flex-end; justify-content: space-between; margin-bottom: 12px; }
  .lk-kicker { font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--acc); }
  .lk h2 { margin: 4px 0; font: 700 1.25rem/1.2 Georgia, "Times New Roman", serif; }
  .lk-sub { margin: 0; color: var(--mut); font-size: .9rem; max-width: 60ch; }
  .lk-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .lk-chip, .lk-pedal { font-size: .78rem; color: var(--mut); padding: 6px 10px; border-radius: 10px; background: var(--bg); border: 1px solid var(--bd); }
  .lk-pedal.on { color: #fff; background: #16a34a; border-color: #16a34a; font-weight: 700; }
  .lk-btn { min-height: 36px; padding: 6px 12px; border: 1px solid var(--bd); border-radius: 10px; background: var(--bg); color: var(--fg); font: inherit; font-size: .8rem; font-weight: 700; cursor: pointer; }
  .lk-btn:hover { border-color: var(--acc); }
  .lk-toggle[aria-pressed="true"] { background: var(--card); box-shadow: 0 1px 2px rgb(0 0 0 / .12); }
  .lk-focus[aria-pressed="true"] { background: var(--acc); color: #fff; border-color: var(--acc); }
  .lk.is-focused { outline: 2px solid color-mix(in srgb, var(--acc) 55%, transparent); outline-offset: 2px; box-shadow: 0 0 0 4px color-mix(in srgb, var(--acc) 18%, transparent); }
  .lk:focus { outline: none; }
  .lk:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }
  .lk-live { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 4px 0 10px; color: var(--mut); font-size: .85rem; }
  .lk-live b { color: var(--fg); font-variant-numeric: tabular-nums; }

  .lk-keys-scroll { overflow-x: auto; border-radius: 14px; -webkit-overflow-scrolling: touch; padding-bottom: 2px; }
  .lk-keys {
    position: relative;
    display: flex;
    min-width: 760px;
    height: clamp(170px, 26vw, 230px);
    border: 2px solid #1f2937;
    border-radius: 10px;
    overflow: hidden;
    background: #111827;
    box-shadow: inset 0 -4px 0 rgba(0,0,0,.25), 0 6px 18px rgba(0,0,0,.18);
  }
  .lk-key { position: relative; padding: 0; margin: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; touch-action: manipulation; font: inherit; }
  .lk-key--white {
    flex: 1 1 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 8px;
    gap: 2px;
    border: 0;
    border-right: 1px solid #cbd5e1;
    border-bottom: 4px solid #d1d5db;
    border-radius: 0 0 6px 6px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 55%, #eef2f7 100%);
    box-shadow: inset 0 1px 0 #fff;
  }
  .lk-key--white:last-of-type { border-right: 0; }
  .lk-key--black {
    position: absolute;
    top: 0;
    z-index: 3;
    width: var(--bw, 3.2%);
    height: 62%;
    border: 1px solid #0b0f19;
    border-top: 0;
    border-radius: 0 0 5px 5px;
    background: linear-gradient(180deg, #374151 0%, #111827 45%, #030712 100%);
    box-shadow: inset 0 -8px 8px rgba(255,255,255,.06), 2px 3px 5px rgba(0,0,0,.45);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 6px;
  }
  .lk-key-note { font-size: .58rem; font-weight: 700; color: #64748b; pointer-events: none; line-height: 1; }
  .lk-key-qwerty { font: 700 .62rem/1 system-ui, sans-serif; color: var(--acc); pointer-events: none; display: none; }
  .lk-key.has-qwerty .lk-key-qwerty { display: block; }
  .lk-key--black .lk-key-qwerty { color: #fff; font-size: .58rem; text-shadow: 0 1px 2px #000; }

  .lk-key--white.is-active, .lk-key--white:active {
    background: linear-gradient(180deg, color-mix(in srgb, var(--acc) 65%, #fff), color-mix(in srgb, var(--acc) 85%, #fff));
    border-bottom-color: color-mix(in srgb, var(--acc) 55%, #000);
    transform: translateY(1px);
  }
  .lk-key--white.is-active .lk-key-note { color: #fff; }
  .lk-key--black.is-active, .lk-key--black:active {
    background: linear-gradient(180deg, color-mix(in srgb, var(--acc) 70%, #111), var(--acc));
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.35);
  }
  .lk-key--white.is-user { background: linear-gradient(180deg, #fde68a, #f59e0b) !important; border-bottom-color: #b45309; transform: translateY(1px); }
  .lk-key--white.is-user .lk-key-note, .lk-key--white.is-user .lk-key-qwerty { color: #111; }
  .lk-key--black.is-user { background: linear-gradient(180deg, #fbbf24, #b45309) !important; box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); }

  .lk-key:focus-visible { outline: 2px solid var(--acc); outline-offset: -2px; z-index: 4; }
  .lk-hint { margin: 10px 0 0; color: var(--mut); font-size: .8rem; text-align: center; }

  @media (max-width: 520px) {
    .lk { padding: 12px; }
    .lk-head { align-items: flex-start; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .lk-key, .lk-btn { transition: none; } }
</style>
