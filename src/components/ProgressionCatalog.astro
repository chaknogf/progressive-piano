---
import { CATEGORIES, PROGRESSIONS } from "../data/progressions";
import DegreeLine from "./DegreeLine.astro";
import { displayNote } from "../lib/theory";
---

<div class="row" id="flt">
  <button class="f on" type="button" data-c="" aria-pressed="true">Todas</button
  >
  {
    Object.entries(CATEGORIES).map(([key, label]) => (
      <button class="f" type="button" data-c={key} aria-pressed="false">
        {label}
      </button>
    ))
  }
  <span class="divider">|</span>
  <button class="f nivel on" type="button" data-nivel="" aria-pressed="true">Todos los niveles</button>
  {
    ["inicial", "intermedio", "avanzado"].map((nivel) => (
      <button class="f nivel" type="button" data-nivel={nivel} aria-pressed="false">
        {nivel.charAt(0).toUpperCase() + nivel.slice(1)}
      </button>
    ))
  }
  <span id="catalog-status" role="status" aria-live="polite"></span>
</div>
<div class="grid" id="cat">
  {
    PROGRESSIONS.map((item) => {
      const levelLabel =
        item.level === "inicial"
          ? "Inicial⭐️"
          : item.level === "intermedio"
            ? "Intermedio ⭐️⭐️"
            : "Avanzado ⭐️⭐️⭐️";
      return (
        <article class="cd" data-c={item.category} data-nivel={item.level}>
          <span class="tg">{CATEGORIES[item.category]}</span>
          <h3>{item.title}</h3>
          <p class="gr">
            <DegreeLine degrees={item.degrees} />
          </p>
          <div class="chips">
            {item.chords.map((chord) => (
              <button class="ch" type="button" data-n={chord}>
                {displayNote(chord)}
              </button>
            ))}
          </div>
          <p>{item.description}</p>
          {item.songs && <p class="sg">♪ {item.songs}</p>}
          {item.sources?.length && (
            <p class="sg">
              Fuentes:{" "}
              {item.sources.map((source, index) => (
                <>
                  {index > 0 && " · "}
                  <a href={source.url} target="_blank" rel="noreferrer">
                    {source.label}
                  </a>
                </>
              ))}
            </p>
          )}
          <div class="v" />
          <button class="pp" type="button" data-ch={item.chords.join(" ")}>
            ▶ Tocar progresión
          </button>
          <span class={`badge level-badge level-${item.level}`}>{levelLabel}</span>
        </article>
      );
    })
  }
</div>

<script>
  import { must } from "../lib/dom";

  const filterRow = must(document.getElementById("flt"), "#flt");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("#cat .cd"));
  const status = must(document.getElementById("catalog-status"), "#catalog-status");
  let activeCategory = "";
  let activeLevel = "";

  function applyFilters(): void {
    let visibleCount = 0;
    cards.forEach((card) => {
      const categoryMatches = !activeCategory || card.dataset.c === activeCategory;
      const levelMatches = !activeLevel || card.dataset.nivel === activeLevel;
      card.hidden = !(categoryMatches && levelMatches);
      if (!card.hidden) visibleCount++;
    });
    status.textContent = `${visibleCount} ${visibleCount === 1 ? "progresión visible" : "progresiones visibles"}.`;
  }

  filterRow.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".f");
    if (!button) return;
    const isLevel = button.classList.contains("nivel");
    const groupSelector = isLevel ? ".nivel" : ".f:not(.nivel)";
    filterRow.querySelectorAll<HTMLButtonElement>(groupSelector).forEach((candidate) => {
      const selected = candidate === button;
      candidate.classList.toggle("on", selected);
      candidate.setAttribute("aria-pressed", String(selected));
    });
    if (isLevel) activeLevel = button.dataset.nivel ?? "";
    else activeCategory = button.dataset.c ?? "";
    applyFilters();
  });

  applyFilters();
</script>
