---
import { CATEGORIES, PROGRESSIONS } from "../data/progressions";
import DegreeLine from "./DegreeLine.astro";
import { displayNote } from "../lib/theory";
---

<div class="row" id="flt">
  <button class="f on" type="button" data-c="" aria-pressed="true">Todas</button
  >
  {
    Object.entries(CATEGORIES).map(([key, label]) => (
      <button class="f" type="button" data-c={key} aria-pressed="false">
        {label}
      </button>
    ))
  }
  <span class="divider">|</span>
  <button class="f nivel on" type="button" data-nivel="">Todas</button>
  {
    ["inicial", "intermedio", "avanzado"].map((nivel) => (
      <button class="f nivel" type="button" data-nivel={nivel}>
        {nivel.charAt(0).toUpperCase() + nivel.slice(1)}
      </button>
    ))
  }
</div>
<div class="grid" id="cat">
  {
    PROGRESSIONS.map((item) => {
      const levelClass = `level-{item.level}`;
      const levelLabel =
        item.level === "inicial"
          ? "Inicial⭐️"
          : item.level === "intermedio"
            ? "Intermedio ⭐️⭐️"
            : "Avanzado ⭐️⭐️⭐️";
      return (
        <article class="cd" data-c={item.category} data-nivel={item.level}>
          <span class="tg">{CATEGORIES[item.category]}</span>
          <h3>{item.title}</h3>
          <p class="gr">
            <DegreeLine degrees={item.degrees} />
          </p>
          <div class="chips">
            {item.chords.map((chord) => (
              <button class="ch" type="button" data-n={chord}>
                {displayNote(chord)}
              </button>
            ))}
          </div>
          <p>{item.description}</p>
          {item.songs && <p class="sg">♪ {item.songs}</p>}
          {item.sources?.length && (
            <p class="sg">
              Fuentes:{" "}
              {item.sources.map((source, index) => (
                <>
                  {index > 0 && " · "}
                  <a href={source.url} target="_blank" rel="noreferrer">
                    {source.label}
                  </a>
                </>
              ))}
            </p>
          )}
          <div class="v" />
          <button class="pp" type="button" data-ch={item.chords.join(" ")}>
            ▶ Tocar progresión
          </button>
          <span class="badge level-badge ${levelClass}">{levelLabel}</span>
        </article>
      );
    })
  }
</div>

<script>
  import { must } from "../lib/dom";

  const filterRow = must(document.getElementById("flt"), "#flt");
  filterRow.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      ".f",
    );
    if (!button) return;
    filterRow.querySelectorAll<HTMLButtonElement>(".f").forEach((candidate) => {
      candidate.classList.toggle("on", candidate === button);
      candidate.setAttribute("aria-pressed", String(candidate === button));
    });
    document.querySelectorAll<HTMLElement>("#cat .cd").forEach((card) => {
      card.style.display =
        !button.dataset.c || card.dataset.c === button.dataset.c ? "" : "none";
    });
  });

  const nivelRow = must(document.getElementById("flt"), "#flt");
  nivelRow.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      ".nivel",
    );
    if (!button) return;
    nivelRow
      .querySelectorAll<HTMLButtonElement>(".nivel")
      .forEach((candidate) => {
        candidate.classList.toggle("on", candidate === button);
        candidate.setAttribute("aria-pressed", String(candidate === button));
      });
    document.querySelectorAll<HTMLElement>("#cat .cd").forEach((card) => {
      const cardLevel = card.dataset.nivel;
      const show = !button.dataset.nivel || cardLevel === button.dataset.nivel;
      card.style.display = show ? "" : "none";
    });
  });
</script>
