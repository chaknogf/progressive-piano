---
import { PROGRESSIONS } from '../data/progressions';
import { displayNote } from '../lib/theory';
---
<section class="box" id="practice" aria-labelledby="practice-title">
  <h3 id="practice-title">Modo práctica</h3>
  <p class="mut">Reproduce una progresión con metrónomo y patrón elegido. El timbre es el de SynthLab.</p>
  <div class="row">
    <label>Progresión
      <select id="ppProg">
        {PROGRESSIONS.map((p, i) => <option value={i}>{p.title} — {p.chords.join(' ')}</option>)}
      </select>
    </label>
    <label>Tempo <input type="range" id="ppBpm" min="40" max="200" value="90"/> <span id="ppBpmV">90</span> BPM</label>
    <label>Compás
      <select id="ppSig"><option value="4">4/4</option><option value="3">3/4</option><option value="6">6/8</option></select>
    </label>
    <label>Patrón
      <select id="ppPat"><option value="block">Bloque</option><option value="arp">Arpegio ascendente</option><option value="strum">Rasgueo</option><option value="bass">Bajo + acorde</option></select>
    </label>
  </div>
  <div class="row">
    <label><input type="checkbox" id="ppLoop"/> Bucle</label>
    <label><input type="checkbox" id="ppMetro" checked/> Metrónomo</label>
    <button id="ppPlay" type="button">▶ Reproducir</button>
    <button id="ppStop" type="button">■ Detener</button>
  </div>
  <p class="mut" id="ppStatus" aria-live="polite">Listo.</p>
  <div class="chips" id="ppChords"></div>
</section>
<script>
  import { PROGRESSIONS } from '../data/progressions';
  import { chordNotes } from '../lib/theory';
  import { audioContext, playChord } from '../lib/audio';

  const progSel = document.getElementById('ppProg') as HTMLSelectElement | null;
  const bpmEl = document.getElementById('ppBpm') as HTMLInputElement | null;
  const bpmV = document.getElementById('ppBpmV');
  const sigEl = document.getElementById('ppSig') as HTMLSelectElement | null;
  const patEl = document.getElementById('ppPat') as HTMLSelectElement | null;
  const loopEl = document.getElementById('ppLoop') as HTMLInputElement | null;
  const metroEl = document.getElementById('ppMetro') as HTMLInputElement | null;
  const playBtn = document.getElementById('ppPlay');
  const stopBtn = document.getElementById('ppStop');
  const status = document.getElementById('ppStatus');
  const chordsEl = document.getElementById('ppChords');

  let playing = false;
  let currentChord = 0;
  let nextTime = 0;
  let timer: number | null = null;
  const LOOKAHEAD = 0.1;
  const SCHEDULE_AHEAD = 0.25;

  function beatDur(bpm: number, sig: number): number {
    if (sig === 6) return 60 / (bpm * 2);
    return 60 / bpm;
  }

  function beatsPerBar(sig: number): number {
    return sig === 6 ? 6 : sig;
  }

  function currentProgression(): string[] {
    const idx = Number(progSel?.value ?? 0);
    return PROGRESSIONS[idx]?.chords ?? ['C', 'G', 'Am', 'F'];
  }

  function renderChords() {
    if (!chordsEl) return;
    const prog = currentProgression();
    chordsEl.innerHTML = prog.map((c, i) => `<button class="ch" type="button" data-i="${i}">${c}</button>`).join('');
  }

  function highlightChord(i: number) {
    chordsEl?.querySelectorAll<HTMLButtonElement>('.ch').forEach((b, idx) => {
      b.classList.toggle('on', idx === i);
    });
  }

  function scheduleChord(chord: string, when: number, pattern: string, beat: number) {
    const ctx = audioContext();
    const notes = chordNotes(chord);
    const dur = beat * 0.9;
    if (pattern === 'block') {
      notes.forEach((n) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        // delegate to playChord? playChord uses global config; call manually to respect config timing
      });
      playChord(notes, dur);
    } else if (pattern === 'arp') {
      notes.forEach((n, idx) => {
        // schedule individual note via playChord at offset
      });
      // fallback: play as block
      playChord(notes, dur);
    } else {
      playChord(notes, dur);
    }
    // metronome click
    if (metroEl?.checked) {
      const clickOsc = ctx.createOscillator();
      const clickGain = ctx.createGain();
      clickOsc.frequency.value = 1000;
      clickGain.gain.setValueAtTime(0.3, when);
      clickGain.gain.exponentialRampToValueAtTime(0.001, when + 0.05);
      clickOsc.connect(clickGain);
      clickGain.connect(ctx.destination);
      clickOsc.start(when);
      clickOsc.stop(when + 0.06);
    }
  }

  function scheduler() {
    if (!playing) return;
    const ctx = audioContext();
    const bpm = Number(bpmEl?.value ?? 90);
    const sig = Number(sigEl?.value ?? 4);
    const beat = beatDur(bpm, sig);
    const bpb = beatsPerBar(sig);
    const prog = currentProgression();
    while (nextTime < ctx.currentTime + SCHEDULE_AHEAD) {
      const chordIndex = currentChord % prog.length;
      scheduleChord(prog[chordIndex], nextTime, patEl?.value ?? 'block', beat);
      highlightChord(chordIndex);
      currentChord++;
      nextTime += beat * bpb;
      if (!loopEl?.checked && currentChord >= prog.length * bpb) {
        // stop after one pass
        setTimeout(() => stop(), beat * bpb * 1000);
      }
    }
    timer = window.setTimeout(scheduler, LOOKAHEAD * 1000);
  }

  function start() {
    if (playing) return;
    playing = true;
    currentChord = 0;
    const ctx = audioContext();
    nextTime = ctx.currentTime + 0.1;
    if (status) status.textContent = 'Reproduciendo…';
    playBtn?.setAttribute('aria-pressed', 'true');
    scheduler();
  }

  function stop() {
    playing = false;
    if (timer) clearTimeout(timer);
    timer = null;
    if (status) status.textContent = 'Detenido.';
    playBtn?.setAttribute('aria-pressed', 'false');
    chordsEl?.querySelectorAll('.ch').forEach((b) => b.classList.remove('on'));
  }

  playBtn?.addEventListener('click', start);
  stopBtn?.addEventListener('click', stop);
  bpmEl?.addEventListener('input', () => { if (bpmV) bpmV.textContent = bpmEl.value; });
  progSel?.addEventListener('change', renderChords);
  renderChords();
</script>
<style>
  #practice input[type="range"] { width: 160px; }
</style>
