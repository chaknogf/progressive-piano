---
import { DIATONIC_KEYS, diatonicChords } from '../lib/theory';

const INITIAL_CHORDS = diatonicChords('C', 'major');
const INITIAL_FORMULA = 'M · m · m · M · M · m · dim';

function qualityLabel(quality: string): string {
  return quality === 'major' ? 'Mayor' : quality === 'minor' ? 'Menor' : 'Disminuido';
}

function functionLabel(index: number): string {
  return index === 0 ? 'Casa' : index === 3 ? 'Te alejas' : index === 4 ? 'Tensión' : '';
}

function tonicLabel(key: string): string {
  return key.replaceAll('#', '♯').replaceAll('b', '♭');
}
---

<section class="key-tool" data-key-tool aria-labelledby="key-tool-title">
  <h3 id="key-tool-title">Acordes diatónicos por tonalidad</h3>
  <div class="key-controls">
    <label for="chord-key">Tonalidad</label>
    <select id="chord-key" aria-label="Elige una tonalidad">
      {DIATONIC_KEYS.major.map((key) => <option value={key}>{tonicLabel(key)}</option>)}
    </select>
    <div class="mode-switch" role="group" aria-label="Modo de la escala">
      <button type="button" class="mode-choice on" data-mode="major" aria-pressed="true">Mayor</button>
      <button type="button" class="mode-choice" data-mode="minor" aria-pressed="false">Menor</button>
    </div>
    <button type="button" class="relative-button" data-relative>Ver el relativo</button>
    <span class="relative-hint" data-relative-hint aria-live="polite">La menor</span>
  </div>
  <p class="key-formula"><b>Calidades:</b> <span data-formula>{INITIAL_FORMULA}</span></p>
  <div class="key-chord-grid" data-chord-grid aria-label="Acordes de la escala">
    {INITIAL_CHORDS.map((chord, index) => (
      <button
        type="button"
        class:list={['key-chord', `quality-${chord.quality}`, { selected: index === 0 }]}
        data-chord-index={index}
        aria-pressed={index === 0 ? 'true' : 'false'}
      >
        <span class="chord-degree">{chord.degree}</span>
        <span class="chord-name">{chord.name}</span>
        <span class="chord-quality">{qualityLabel(chord.quality)}</span>
        {functionLabel(index) && <span class="chord-function">{functionLabel(index)}</span>}
      </button>
    ))}
  </div>
  <div class="key-viewer-card">
    <p class="key-viewer-label" data-selected-label aria-live="polite">Selecciona un acorde para ver sus notas.</p>
    <div class="v" data-chord-view></div>
  </div>
</section>

<script>
  import { chordNotes, diatonicChords, pitchClass, type ScaleMode } from '../lib/theory';
  import { playSequence } from '../lib/audio';
  import { renderChordView } from '../lib/views';
  import { must } from '../lib/dom';

  const root = must(document.querySelector<HTMLElement>('[data-key-tool]'), '[data-key-tool]');
  const keySelect = must(root.querySelector<HTMLSelectElement>('[id="chord-key"]'), '#chord-key');
  const grid = must(root.querySelector<HTMLElement>('[data-chord-grid]'), '[data-chord-grid]');
  const formula = must(root.querySelector<HTMLElement>('[data-formula]'), '[data-formula]');
  const view = must(root.querySelector<HTMLElement>('[data-chord-view]'), '[data-chord-view]');
  const selectedLabel = must(root.querySelector<HTMLElement>('[data-selected-label]'), '[data-selected-label]');
  const relativeHint = must(root.querySelector<HTMLElement>('[data-relative-hint]'), '[data-relative-hint]');
  const relativeButton = must(root.querySelector<HTMLButtonElement>('[data-relative]'), '[data-relative]');
  const modeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode]'));
  const majorKeys = DIATONIC_KEYS.major;
  const minorKeys = DIATONIC_KEYS.minor;
  const formulas: Record<ScaleMode, string> = {
    major: 'M · m · m · M · M · m · dim',
    minor: 'm · dim · M · m · m · M · M',
  };

  let currentMode: ScaleMode = 'major';
  let currentKey = 'C';
  let chords = diatonicChords(currentKey, currentMode);

  function keyLabel(key: string): string {
    return key.replaceAll('#', '♯').replaceAll('b', '♭');
  }

  function qualityLabel(quality: string): string {
    return quality === 'major' ? 'Mayor' : quality === 'minor' ? 'Menor' : 'Disminuido';
  }

  function functionLabel(index: number): string {
    return index === 0 ? 'Casa' : index === 3 ? 'Te alejas' : index === 4 ? 'Tensión' : '';
  }

  function setKeys(mode: ScaleMode, selected: string): void {
    const keys = mode === 'major' ? majorKeys : minorKeys;
    keySelect.replaceChildren(...keys.map((key) => {
      const option = document.createElement('option');
      option.value = key;
      option.textContent = keyLabel(key);
      return option;
    }));
    keySelect.value = selected;
  }

  function renderSelected(index: number, shouldPlay = true): void {
    const chord = chords[index];
    if (!chord) return;
    grid.querySelectorAll<HTMLButtonElement>('[data-chord-index]').forEach((button) => {
      const selected = Number(button.dataset.chordIndex) === index;
      button.classList.toggle('selected', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    selectedLabel.textContent = `${chord.degree} · ${chord.name} (${qualityLabel(chord.quality)})`;
    renderChordView(view, chord.name);
    if (shouldPlay) playSequence([chordNotes(chord.name)], 0, 1.3);
  }

  function render(mode: ScaleMode, key: string, selectedIndex = 0): void {
    currentMode = mode;
    currentKey = key;
    chords = diatonicChords(key, mode);
    setKeys(mode, key);
    formula.textContent = formulas[mode];
    modeButtons.forEach((button) => {
      const selected = button.dataset.mode === mode;
      button.classList.toggle('on', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    grid.innerHTML = chords.map((chord, index) => {
      const label = functionLabel(index);
      return `<button type="button" class="key-chord quality-${chord.quality}${index === selectedIndex ? ' selected' : ''}" data-chord-index="${index}" aria-pressed="${index === selectedIndex}">
        <span class="chord-degree">${chord.degree}</span>
        <span class="chord-name">${chord.name}</span>
        <span class="chord-quality">${qualityLabel(chord.quality)}</span>
        ${label ? `<span class="chord-function">${label}</span>` : ''}
      </button>`;
    }).join('');
    renderSelected(selectedIndex, false);

    const relativeMode: ScaleMode = mode === 'major' ? 'minor' : 'major';
    const relativeChord = chords[mode === 'major' ? 5 : 2];
    relativeHint.textContent = `${keyLabel(relativeChord.root)} ${relativeMode === 'minor' ? 'menor' : 'mayor'}`;
    relativeButton.setAttribute('aria-label', `Ver el relativo: ${relativeHint.textContent}`);
  }

  keySelect.addEventListener('change', () => render(currentMode, keySelect.value));
  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const mode = button.dataset.mode as ScaleMode;
      const validKeys = mode === 'major' ? majorKeys : minorKeys;
      const currentPitch = pitchClass(currentKey);
      const nextKey = validKeys.find((key) => pitchClass(key) === currentPitch) ?? (mode === 'major' ? 'C' : 'A');
      render(mode, nextKey);
    });
  });
  grid.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-chord-index]');
    if (button) renderSelected(Number(button.dataset.chordIndex));
  });
  relativeButton.addEventListener('click', () => {
    const nextMode: ScaleMode = currentMode === 'major' ? 'minor' : 'major';
    const relativeChord = chords[currentMode === 'major' ? 5 : 2];
    const relativeRoot = relativeChord.root.replaceAll('♯', '#').replaceAll('♭', 'b');
    const relativePitch = pitchClass(relativeRoot);
    const keys = nextMode === 'major' ? majorKeys : minorKeys;
    const nextKey = keys.find((key) => pitchClass(key) === relativePitch) ?? relativeRoot;
    render(nextMode, nextKey);
  });

  render(currentMode, currentKey, 0);
</script>

<style>
  .key-tool { margin: 1.2em 0; padding: 16px; border: 1px solid var(--bd); border-radius: 14px; background: var(--card); }
  .key-tool h3 { margin-top: 0; }
  .key-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .key-controls label { font-weight: 650; }
  .mode-switch { display: inline-flex; gap: 4px; padding: 3px; border: 1px solid var(--bd); border-radius: 999px; }
  .mode-switch button { border: 0; padding-inline: 12px; }
  .relative-hint, .key-formula { color: var(--mut); }
  .relative-hint { font-size: 0.9rem; }
  .key-formula { margin: 0.8em 0; }
  .key-chord-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; }
  .key-chord { display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; min-height: 84px; padding: 10px; border-radius: 12px; text-align: left; }
  .key-chord.selected { outline: 2px solid var(--acc); outline-offset: 1px; }
  .chord-degree { font-weight: 750; }
  .chord-name { grid-column: 1 / -1; font-size: 1.2rem; font-weight: 750; }
  .chord-quality { font-size: 0.75rem; font-weight: 650; }
  .chord-function { justify-self: end; font-size: 0.72rem; color: var(--mut); }
  .quality-major { border-color: var(--quality-major, #3b82f6); }
  .quality-minor { border-color: var(--quality-minor, #a855f7); }
  .quality-diminished { border-color: var(--quality-dim, #d97706); border-style: dashed; }
  .quality-major .chord-quality { color: var(--quality-major, #2563eb); }
  .quality-minor .chord-quality { color: var(--quality-minor, #9333ea); }
  .quality-diminished .chord-quality { color: var(--quality-dim, #b45309); }
  .key-viewer-card { margin-top: 14px; padding: 12px; border-radius: 12px; background: var(--bg); }
  .key-viewer-label { margin: 0; font-weight: 650; }
  .key-viewer-card .v:empty { display: none; }
  .key-viewer-card .v:not(:empty) { margin-top: 8px; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .quality-major .chord-quality { color: #93c5fd; }
    :root:not([data-theme="light"]) .quality-minor .chord-quality { color: #d8b4fe; }
    :root:not([data-theme="light"]) .quality-diminished .chord-quality { color: #fcd34d; }
  }
  :global(:root[data-theme="dark"]) .quality-major .chord-quality { color: #93c5fd; }
  :global(:root[data-theme="dark"]) .quality-minor .chord-quality { color: #d8b4fe; }
  :global(:root[data-theme="dark"]) .quality-diminished .chord-quality { color: #fcd34d; }
</style>
