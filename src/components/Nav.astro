---
const levels: { title: string; links: [string, string][] }[] = [
  {
    title: "Inicial⭐️",
    links: [
      ["s1", "Leer progresiones"],
      ["s2", "Acordes"],
      ["s9", "Trastes y dedos"],
      ["afinador", "Afinador"],
      ["s10", "Ritmo"],
      ["s7", "Consejos"],
      ["s3", "Primeras progresiones"],
    ],
  },
  {
    title: "Intermedio ⭐️⭐️",
    links: [
      ["s6", "Modos y emociones"],
      ["s4", "Inversiones"],
      ["s5", "Arpegios"],
    ],
  },
  {
    title: "Avanzado ⭐️⭐️⭐️",
    links: [["s8", "Sonido y producción"], ["s11", "Mapa secreto"]],
  },
];
---

<nav id="nav" aria-label="Secciones del manual">
  <div class="nav-heading">
    <span class="nav-kicker">Explorar</span>
    <span class="nav-hint">Desliza para ver más</span>
  </div>
  <div class="nav-scroller">
    {
      levels.map((level) => (
        <div class="nav-level" role="group" aria-label={level.title}>
          <span class="nav-level-title">{level.title}</span>
          <div class="nav-level-links">
            {level.links.map(([id, label]) => (
              <button type="button" data-go={id} aria-label={`Ir a ${label}`}>
                <span>{label}</span>
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</nav>
<script>
  import { $ } from "../lib/dom";
  const nav = $("#nav");
  const buttons = Array.from(nav?.querySelectorAll<HTMLButtonElement>("button") ?? []);
  const sections = buttons
    .map((button) => document.getElementById(button.dataset.go ?? ""))
    .filter((section): section is HTMLElement => Boolean(section));

  buttons[0]?.classList.add("is-active");

  nav?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>("button");
    const id = button?.dataset.go;
    if (!id) return;
    const destination = document.getElementById(id);
    const disclosure = destination?.closest("details");
    if (disclosure) disclosure.open = true;
    destination?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      buttons.forEach((button) => button.classList.toggle("is-active", button.dataset.go === visible.target.id));
    },
    { rootMargin: "-18% 0px -66% 0px", threshold: [0.1, 0.4, 0.8] },
  );
  sections.forEach((section) => observer.observe(section));
</script>
