---
// src/components/Afinador.astro
// Afinador de guitarra y cromático en tiempo real: micrófono + detección YIN.
// La interfaz sigue el sistema visual del sitio (paleta cálida, serif en títulos)
// y usa patrones de app móvil: modo segmentado, acciones al inicio, bottom sheet.
---

<section
  class="afinador"
  id="afinador-app"
  aria-label="Afinador de guitarra y cromático"
>
  <header class="af-head">
    <div class="af-title">
      <span class="af-logo" aria-hidden="true">🎸</span>
      <div class="af-title-text">
        <h2 class="af-heading">Afinador</h2>
        <p class="af-status" id="af-status" aria-hidden="true">Inactivo</p>
      </div>
    </div>
    <button
      type="button"
      class="af-iconbtn"
      id="af-settings"
      aria-label="Abrir ajustes del afinador"
      aria-haspopup="dialog"
      aria-controls="af-sheet"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="3"></circle>
        <path
          d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
        ></path>
      </svg>
    </button>
  </header>

  <div class="af-mode" id="af-mode" role="group" aria-label="Modo de afinación">
    <button type="button" class="af-seg" id="af-mode-guitar" aria-pressed="true"
      >Guitarra</button
    >
    <button type="button" class="af-seg" id="af-mode-chromatic" aria-pressed="false"
      >Cromático</button
    >
  </div>

  <div class="af-actions">
    <button type="button" class="af-primary" id="af-start" aria-pressed="false">
      <span class="af-start-icon" aria-hidden="true">🎤</span>
      <span id="af-start-label">Activar micrófono</span>
    </button>
    <button type="button" class="af-secondary" id="af-ref">
      <span aria-hidden="true">🔊</span> Referencia
    </button>
  </div>

  <div class="af-display" id="af-display" data-state="idle">
    <div class="af-note-wrap">
      <div class="af-note" id="af-note" aria-hidden="true">—</div>
      <div class="af-cents"><span id="af-cents-value">0</span> cents</div>
      <p class="af-sub" id="af-sub">Activa el micrófono y toca una cuerda.</p>
    </div>

    <svg
      class="af-meter"
      viewBox="0 0 320 96"
      role="meter"
      id="af-meter"
      aria-label="Desviación de la afinación en cents"
      aria-valuemin="-50"
      aria-valuemax="50"
      aria-valuenow="0"
      aria-valuetext="Sin señal"
    >
      <rect x="20" y="30" width="280" height="12" rx="6" class="af-track"></rect>
      <rect x="20" y="30" width="70" height="12" rx="6" class="af-zone-low"></rect>
      <rect x="230" y="30" width="70" height="12" rx="6" class="af-zone-high"></rect>
      <rect x="146" y="30" width="28" height="12" class="af-zone-ok"></rect>
      <g class="af-ticks">
        <line x1="20" y1="24" x2="20" y2="48"></line>
        <line x1="90" y1="28" x2="90" y2="44"></line>
        <line x1="160" y1="22" x2="160" y2="50"></line>
        <line x1="230" y1="28" x2="230" y2="44"></line>
        <line x1="300" y1="24" x2="300" y2="48"></line>
      </g>
      <g id="af-needle" class="af-needle"
        ><line x1="160" y1="16" x2="160" y2="54"></line><circle
          cx="160"
          cy="16"
          r="6"></circle></g
      >
      <text x="20" y="72" class="af-lbl" text-anchor="start">-50</text>
      <text x="160" y="72" class="af-lbl" text-anchor="middle">0</text>
      <text x="300" y="72" class="af-lbl" text-anchor="end">+50</text>
      <text x="160" y="90" class="af-lbl af-lbl-unit" text-anchor="middle">cents</text>
    </svg>

    <p class="af-verdict" id="af-verdict" role="status" aria-live="polite">
      Esperando micrófono…
    </p>
  </div>

  <div class="af-board">
    <div class="af-board-head">
      <h3 class="af-board-title" id="af-board-title">Cuerdas</h3>
      <div class="af-board-tools">
        <button type="button" class="af-chip" id="af-auto" aria-pressed="true"
          >Auto</button
        >
        <button type="button" class="af-chip" id="af-reset">Limpiar</button>
      </div>
    </div>
    <div
      class="af-strings"
      id="af-strings"
      role="group"
      aria-labelledby="af-board-title"
    >
    </div>
  </div>

  <div class="af-signal" aria-hidden="true">
    <span class="af-signal-dot" id="af-signal-dot"></span>
    <span class="af-signal-label">Señal</span>
    <div class="af-bar"><i id="af-level"></i></div>
  </div>

  <p class="af-hint" id="af-hint">
    Acerca el móvil a la guitarra, toca una sola cuerda y deja que suene.
  </p>
  <p class="af-privacy">
    🔒 El audio se analiza en tiempo real en tu dispositivo: no se graba ni se
    envía a ningún servidor.
  </p>

  <dialog class="af-sheet" id="af-sheet" aria-labelledby="af-sheet-title">
    <div class="af-sheet-bar" id="af-sheet-bar" aria-hidden="true"></div>
    <div class="af-sheet-head">
      <h2 class="af-sheet-title" id="af-sheet-title">Ajustes</h2>
      <button
        type="button"
        class="af-iconbtn"
        id="af-sheet-close"
        aria-label="Cerrar ajustes"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          ><path d="M18 6 6 18M6 6l12 12"></path></svg
        >
      </button>
    </div>
    <div class="af-sheet-body">
      <label class="af-field" for="af-tuning" id="af-tuning-field">
        Afinación
        <select id="af-tuning"></select>
      </label>
      <label class="af-field" for="af-refpitch">
        Referencia A4
        <select id="af-refpitch">
          <option value="432">432 Hz</option>
          <option value="440" selected>440 Hz (estándar)</option>
          <option value="442">442 Hz</option>
          <option value="444">444 Hz</option>
        </select>
      </label>
    </div>
  </dialog>
</section>

<script>
  import { $, must } from "../lib/dom";
  import {
    NOTE_NAMES,
    centsBetween,
    createPitchDetector,
    foldToReference,
    freqToMidi,
    hz,
    matchString,
    nearestMidiForPitchClass,
    noteName,
    pitchClassOf,
  } from "../lib/tuner";

  // ── Datos ──────────────────────────────────────────────────────────
  const NOTES = NOTE_NAMES;
  // midi de cada cuerda, de la 6.ª (grave) a la 1.ª (aguda)
  const TUNINGS: { name: string; midi: number[] }[] = [
    { name: "Estándar (E A D G B e)", midi: [40, 45, 50, 55, 59, 64] },
    { name: "Drop D", midi: [38, 45, 50, 55, 59, 64] },
    { name: "Medio tono abajo", midi: [39, 44, 49, 54, 58, 63] },
    { name: "DADGAD", midi: [38, 45, 50, 55, 57, 62] },
    { name: "Open G", midi: [38, 43, 50, 55, 59, 62] },
    { name: "Open D", midi: [38, 45, 50, 54, 57, 62] },
  ];
  const MIN_HZ = 55;
  const MAX_HZ = 1200;
  const FFT = 8192;
  const TOLERANCE = 5; // cents
  const HOLD_MS = 800; // tiempo afinada para marcar ✓
  const MIN_RMS = 0.0025; // señal mínima para intentar detectar
  const MIN_CLARITY = 0.65; // periodicidad mínima fiable
  const detectPitch = createPitchDetector({
    minHz: MIN_HZ,
    maxHz: MAX_HZ,
    threshold: 0.15,
  });

  // ── Referencias DOM ────────────────────────────────────────────────
  const root = must(document.getElementById("afinador-app"), "#afinador-app");
  const modeGuitar = must(
    $<HTMLButtonElement>("#af-mode-guitar", root),
    "#af-mode-guitar",
  );
  const modeChromatic = must(
    $<HTMLButtonElement>("#af-mode-chromatic", root),
    "#af-mode-chromatic",
  );
  const settingsButton = must(
    $<HTMLButtonElement>("#af-settings", root),
    "#af-settings",
  );
  const sheet = must($<HTMLDialogElement>("#af-sheet", root), "#af-sheet");
  const sheetClose = must(
    $<HTMLButtonElement>("#af-sheet-close", root),
    "#af-sheet-close",
  );
  const sheetBar = must($("#af-sheet-bar", root), "#af-sheet-bar");
  const tuningField = must(
    $("#af-tuning-field", root),
    "#af-tuning-field",
  );
  const tuningSelect = must(
    $<HTMLSelectElement>("#af-tuning", root),
    "#af-tuning",
  );
  const refPitchSelect = must(
    $<HTMLSelectElement>("#af-refpitch", root),
    "#af-refpitch",
  );
  const statusEl = must($("#af-status", root), "#af-status");
  const display = must($("#af-display", root), "#af-display");
  const noteEl = must($("#af-note", root), "#af-note");
  const centsValue = must($("#af-cents-value", root), "#af-cents-value");
  const subEl = must($("#af-sub", root), "#af-sub");
  const meter = must($("#af-meter", root), "#af-meter");
  const needle = must($("#af-needle", root), "#af-needle");
  const verdict = must($("#af-verdict", root), "#af-verdict");
  const boardTitle = must($("#af-board-title", root), "#af-board-title");
  const autoButton = must($<HTMLButtonElement>("#af-auto", root), "#af-auto");
  const resetButton = must(
    $<HTMLButtonElement>("#af-reset", root),
    "#af-reset",
  );
  const stringsEl = must($("#af-strings", root), "#af-strings");
  const startButton = must(
    $<HTMLButtonElement>("#af-start", root),
    "#af-start",
  );
  const startLabel = must($("#af-start-label", root), "#af-start-label");
  const refButton = must($<HTMLButtonElement>("#af-ref", root), "#af-ref");
  const signalDot = must($("#af-signal-dot", root), "#af-signal-dot");
  const levelBar = must($("#af-level", root), "#af-level");
  const hintEl = must($("#af-hint", root), "#af-hint");

  // ── Estado ─────────────────────────────────────────────────────────
  interface WebkitWindow extends Window {
    webkitAudioContext?: typeof AudioContext;
  }
  type Mode = "guitar" | "chromatic";
  type State = "idle" | "ok" | "low" | "high" | "listening";
  const STATUS: Record<State, string> = {
    idle: "Inactivo",
    listening: "Escuchando",
    ok: "Afinada",
    low: "Baja",
    high: "Alta",
  };
  let mode: Mode = "guitar";
  let a4 = 440;
  let tuningIndex = 0;
  let manual: number | null = null; // cuerda fija en modo guitarra
  let targetPc: number | null = null; // nota fija en modo cromático
  let lastStringTarget: number | null = null;
  let lastTargetMidi: number | null = null;
  let done = new Set<string>();
  let ctx: AudioContext | null = null;
  let stream: MediaStream | null = null;
  let analyser: AnalyserNode | null = null;
  let buf = new Float32Array(FFT);
  let timer = 0;
  let history: number[] = [];
  let shown: number | null = null;
  let lastVoiced = 0;
  let lowSignalSince = 0;
  let lastHighlight: number | null = null;
  let inTuneSince = 0;
  let ignoreUntil = 0;
  let lastAnnounce = 0;
  let playCtx: AudioContext | null = null;

  const strings = () =>
    TUNINGS[tuningIndex].midi.map((midi, i) => ({
      midi,
      freq: hz(midi, a4),
      number: 6 - i,
      name: noteName(midi),
    }));
  const doneKey = (index: number): string =>
    mode === "guitar" ? `g-${tuningIndex}-${index}` : `c-${index}`;
  const playMessage = (): string =>
    mode === "guitar"
      ? "Toca una cuerda al aire."
      : "Toca una nota o elige la tonalidad que quieres afinar.";
  const waitingMessage = (): string =>
    mode === "guitar"
      ? "Activa el micrófono y toca una cuerda."
      : "Activa el micrófono y toca una nota.";

  tuningSelect.innerHTML = TUNINGS.map(
    (t, i) => `<option value="${i}">${t.name}</option>`,
  ).join("");

  function renderStrings(active: number | null = null): void {
    lastHighlight = active;
    if (mode === "guitar") {
      boardTitle.textContent = "Cuerdas";
      stringsEl.setAttribute("aria-label", "Cuerdas de la guitarra");
      stringsEl.innerHTML = strings()
        .map((s, i) => {
          const isDone = done.has(doneKey(i));
          return `<button type="button" class="af-str${active === i ? " is-active" : ""}${isDone ? " is-done" : ""}" data-i="${i}" aria-pressed="${manual === i}" aria-label="Cuerda ${s.number}, ${s.name}${isDone ? ", afinada" : ""}">
        <small class="af-str-num">${s.number}ª</small><b>${s.name}</b><span class="af-str-freq">${s.freq.toFixed(1)} Hz${isDone ? " ✓" : ""}</span></button>`;
        })
        .join("");
      return;
    }

    boardTitle.textContent = "Notas";
    stringsEl.setAttribute("aria-label", "Notas para afinar");
    stringsEl.innerHTML = NOTES.map((name, pc) => {
      const isDone = done.has(doneKey(pc));
      const isSelected = targetPc === pc;
      return `<button type="button" class="af-str${active === pc ? " is-active" : ""}${isDone ? " is-done" : ""}" data-pc="${pc}" aria-pressed="${isSelected}" aria-label="${name}${isDone ? ", afinada" : ""}">
        <b>${name}</b><span class="af-str-status">${isDone ? "✓" : isSelected ? "Objetivo" : "&nbsp;"}</span></button>`;
    }).join("");
  }

  function setHint(state: State): void {
    if (state === "ok") {
      hintEl.textContent =
        mode === "guitar"
          ? "¡Afinada! Puedes pasar a la siguiente cuerda."
          : "¡Afinada! Puedes pasar a la siguiente nota.";
    } else if (state === "low") {
      hintEl.textContent =
        mode === "guitar"
          ? "La nota está baja: tensa la cuerda poco a poco."
          : "La nota está baja: sube la afinación poco a poco.";
    } else if (state === "high") {
      hintEl.textContent =
        mode === "guitar"
          ? "La nota está alta: afloja la cuerda con cuidado."
          : "La nota está alta: baja la afinación con cuidado.";
    } else if (state === "listening") {
      hintEl.textContent =
        mode === "guitar"
          ? "Toca una cuerda al aire o elige una para fijarla."
          : "Toca una nota o elige la tonalidad que quieres afinar.";
    } else {
      hintEl.textContent =
        mode === "guitar"
          ? "Acerca el móvil a la guitarra, toca una sola cuerda y deja que suene."
          : "Acerca el móvil al instrumento y toca una nota clara.";
    }
  }

  function setState(state: State): void {
    root.dataset.state = state;
    display.dataset.state = state;
    statusEl.textContent = STATUS[state];
    setHint(state);
  }

  function setNeedle(cents: number | null): void {
    const clamped = cents === null ? 0 : Math.max(-50, Math.min(50, cents));
    needle.style.transform = `translateX(${clamped * 2.8}px)`;
    meter.setAttribute("aria-valuenow", String(Math.round(clamped)));
  }

  function resetReading(message = playMessage()): void {
    shown = null;
    history = [];
    inTuneSince = 0;
    lowSignalSince = 0;
    noteEl.textContent = "—";
    centsValue.textContent = "0";
    subEl.textContent = message;
    verdict.textContent = ctx ? "Escuchando…" : "Esperando micrófono…";
    meter.setAttribute("aria-valuetext", "Sin señal");
    setNeedle(null);
    signalDot.dataset.signal = "low";
    setState(ctx ? "listening" : "idle");
    renderStrings(mode === "guitar" ? manual : null);
  }

  // ── Bucle de análisis ──────────────────────────────────────────────
  function tick(): void {
    if (!analyser || !ctx) return;
    analyser.getFloatTimeDomainData(buf);
    let energy = 0;
    for (let i = 0; i < buf.length; i += 1) energy += buf[i] * buf[i];
    const rms = Math.sqrt(energy / buf.length);
    levelBar.style.width = `${Math.min(100, rms * 800)}%`;
    const strong = rms >= MIN_RMS;
    levelBar.dataset.signal = strong ? "ok" : "low";
    signalDot.dataset.signal = strong ? "ok" : "low";
    const now = performance.now();
    if (now < ignoreUntil) return; // no analizar mientras suena la referencia

    if (!strong) {
      if (!lowSignalSince) lowSignalSince = now;
      if (shown !== null && now - lastVoiced > 900) {
        resetReading();
      } else if (
        shown === null &&
        ctx &&
        now - lowSignalSince > 1800 &&
        now - lastAnnounce > 1200
      ) {
        lastAnnounce = now;
        verdict.textContent =
          mode === "guitar"
            ? "Señal baja: acerca el móvil a la guitarra y toca una sola cuerda."
            : "Señal baja: acerca el micrófono y toca una nota clara.";
      }
      return;
    }
    lowSignalSince = 0;

    const pitch = detectPitch(buf, ctx.sampleRate);
    if (!pitch || pitch.clarity < MIN_CLARITY) {
      if (shown !== null && now - lastVoiced > 900) resetReading();
      return;
    }
    lastVoiced = now;

    // mediana de las últimas mediciones (evita saltos)
    if (
      history.length &&
      Math.abs(centsBetween(pitch.freq, history[history.length - 1])) > 100
    )
      history = [];
    history.push(pitch.freq);
    if (history.length > 5) history.shift();
    const sorted = [...history].sort((a, b) => a - b);
    const f = sorted[Math.floor(sorted.length / 2)];

    let cents: number;
    let noteMidi: number;
    let targetMidi: number;
    let targetLabel: string;
    let doneIndex: number;
    let hint = "";

    if (mode === "guitar") {
      const list = strings();
      const match = matchString(
        f,
        list.map((s) => s.freq),
        manual ?? lastStringTarget,
      );
      if (!match) return;
      const targetIndex = manual ?? match.index;
      if (targetIndex !== lastStringTarget) {
        shown = null;
        inTuneSince = 0;
      }
      lastStringTarget = targetIndex;
      const s = list[targetIndex];
      const folded = foldToReference(f, s.freq);
      cents = folded.cents;
      targetMidi = s.midi;
      noteMidi = Math.round(freqToMidi(folded.freq, a4));
      targetLabel = `Cuerda ${s.number} (${s.name}) · ${folded.freq.toFixed(1)} Hz · objetivo ${s.freq.toFixed(1)} Hz`;
      doneIndex = targetIndex;
      if (manual !== null && match.index !== manual)
        hint = ` Parece que suena la cuerda ${list[match.index].number}.`;
    } else {
      const detectedMidi = Math.round(freqToMidi(f, a4));
      targetMidi =
        targetPc === null
          ? detectedMidi
          : nearestMidiForPitchClass(targetPc, detectedMidi);
      const targetFreq = hz(targetMidi, a4);
      const folded = foldToReference(f, targetFreq);
      cents = folded.cents;
      noteMidi = detectedMidi;
      doneIndex = pitchClassOf(targetMidi);
      targetLabel = `Objetivo: ${noteName(targetMidi)} (${targetFreq.toFixed(1)} Hz) · detectado ${f.toFixed(1)} Hz`;
      if (targetPc !== null && pitchClassOf(detectedMidi) !== targetPc)
        hint = ` Estás tocando ${noteName(detectedMidi)}; el objetivo es ${NOTES[targetPc]}.`;
    }

    lastTargetMidi = targetMidi;
    shown = shown === null ? cents : shown + (cents - shown) * 0.4;
    const rounded = Math.round(shown);
    const name = noteName(noteMidi);

    noteEl.textContent = name;
    centsValue.textContent = String(rounded);
    subEl.textContent = targetLabel;
    setNeedle(shown);

    let text: string;
    if (Math.abs(shown) <= TOLERANCE) {
      setState("ok");
      text = `✓ Afinada (${name}). ¡Perfecto!`;
      if (!inTuneSince) inTuneSince = now;
      if (now - inTuneSince > HOLD_MS && !done.has(doneKey(doneIndex))) {
        done.add(doneKey(doneIndex));
        text =
          mode === "guitar"
            ? `✓ Cuerda ${strings()[doneIndex].number} afinada.`
            : `✓ ${NOTES[doneIndex]} afinada.`;
        renderStrings(doneIndex);
      }
    } else if (shown < 0) {
      setState("low");
      inTuneSince = 0;
      text = `▲ ${name} está baja (${Math.abs(rounded)} cents): ${mode === "guitar" ? "aprieta la clavija" : "sube la afinación"}.${Math.abs(shown) > 50 ? " Estás lejos: gira poco a poco." : ""}`;
    } else {
      setState("high");
      inTuneSince = 0;
      text = `▼ ${name} está alta (${rounded} cents): ${mode === "guitar" ? "afloja la clavija" : "bájala"}.${shown > 50 ? " Estás lejos: gira poco a poco." : ""}`;
    }
    verdict.textContent = text + hint;
    meter.setAttribute(
      "aria-valuetext",
      `${rounded > 0 ? "+" : ""}${rounded} cents`,
    );

    const highlight =
      mode === "guitar" ? doneIndex : pitchClassOf(noteMidi);
    if (highlight !== lastHighlight) renderStrings(highlight);
  }

  // ── Micrófono ──────────────────────────────────────────────────────
  function showError(message: string): void {
    verdict.textContent = message;
    setState("idle");
    startButton.disabled = false;
    startButton.setAttribute("aria-pressed", "false");
    startLabel.textContent = "Activar micrófono";
  }

  async function start(): Promise<void> {
    if (!navigator.mediaDevices?.getUserMedia) {
      showError(
        "Tu navegador no permite usar el micrófono aquí. Usa https y un navegador actualizado.",
      );
      return;
    }
    startButton.disabled = true;
    startLabel.textContent = "Solicitando permiso…";
    verdict.textContent = "Solicitando permiso del micrófono…";
    try {
      const constraints: MediaStreamConstraints = {
        audio: {
          echoCancellation: false,
          noiseSuppression: false,
          // En móviles la señal directa del micrófono suele ser muy baja:
          // el AGC mejora mucho la detección sin alterar la altura.
          autoGainControl: true,
          channelCount: 1,
        },
      };
      try {
        stream = await navigator.mediaDevices.getUserMedia(constraints);
      } catch (error) {
        // Algunos navegadores móviles no admiten todas las restricciones.
        if ((error as DOMException).name !== "OverconstrainedError") throw error;
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      }
      if (!stream) throw new Error("No se pudo abrir el micrófono");
      const Ctor =
        window.AudioContext ?? (window as WebkitWindow).webkitAudioContext;
      if (!Ctor) throw new Error("Web Audio no disponible");
      ctx = new Ctor();
      await ctx.resume();
      const source = ctx.createMediaStreamSource(stream);
      const highpass = ctx.createBiquadFilter();
      highpass.type = "highpass";
      highpass.frequency.value = 40; // quita el rumor grave sin perder notas bajas
      analyser = ctx.createAnalyser();
      analyser.fftSize = FFT;
      analyser.smoothingTimeConstant = 0;
      buf = new Float32Array(analyser.fftSize);
      source.connect(highpass);
      highpass.connect(analyser); // no se conecta a la salida: evita acople
      timer = window.setInterval(tick, 50);
      startButton.disabled = false;
      startButton.setAttribute("aria-pressed", "true");
      startLabel.textContent = "Detener micrófono";
      resetReading();
    } catch (error) {
      stopCapture();
      const name = (error as DOMException).name;
      if (name === "NotAllowedError")
        showError(
          "Permiso denegado. Activa el micrófono para este sitio en los ajustes del navegador.",
        );
      else if (name === "NotFoundError")
        showError("No se encontró ningún micrófono.");
      else
        showError(
          "No se pudo iniciar el micrófono. Revisa los permisos e inténtalo de nuevo.",
        );
    }
  }

  function stopCapture(): void {
    window.clearInterval(timer);
    stream?.getTracks().forEach((track) => track.stop());
    void ctx?.close();
    stream = null;
    ctx = null;
    analyser = null;
    timer = 0;
  }

  function stop(): void {
    stopCapture();
    startButton.setAttribute("aria-pressed", "false");
    startLabel.textContent = "Activar micrófono";
    levelBar.style.width = "0%";
    levelBar.dataset.signal = "low";
    signalDot.dataset.signal = "low";
    lastStringTarget = null;
    lastTargetMidi = null;
    resetReading(waitingMessage());
    verdict.textContent = "Micrófono apagado.";
  }

  // ── Tono de referencia ─────────────────────────────────────────────
  function playReference(): void {
    let midi: number | null = null;
    let guitarIndex: number | null = null;
    if (mode === "guitar") {
      guitarIndex = manual ?? lastStringTarget;
      if (guitarIndex !== null) midi = strings()[guitarIndex].midi;
    } else if (targetPc !== null) {
      midi = nearestMidiForPitchClass(targetPc, lastTargetMidi ?? 69);
    } else {
      midi = lastTargetMidi;
    }
    if (midi === null) {
      verdict.textContent =
        mode === "guitar"
          ? "Elige primero una cuerda para escuchar su referencia."
          : "Toca una nota o elige una tonalidad para escuchar su referencia.";
      return;
    }

    const freq = hz(midi, a4);
    const Ctor =
      window.AudioContext ?? (window as WebkitWindow).webkitAudioContext;
    if (!Ctor) return;
    playCtx = playCtx ?? new Ctor();
    void playCtx.resume();
    const sampleRate = playCtx.sampleRate;
    const frameCount = sampleRate * 2;
    const period = Math.max(2, Math.round(sampleRate / freq));
    const buffer = playCtx.createBuffer(1, frameCount, sampleRate);
    const samples = buffer.getChannelData(0);
    // Síntesis Karplus–Strong, igual que las cuerdas pulsadas del simulador.
    for (let i = 0; i < period; i++) samples[i] = Math.random() * 2 - 1;
    for (let i = period + 1; i < frameCount; i++) {
      samples[i] = 0.4985 * (samples[i - period] + samples[i - period - 1]);
    }
    const t = playCtx.currentTime;
    const source = playCtx.createBufferSource();
    const gain = playCtx.createGain();
    gain.gain.value = 0.5;
    source.buffer = buffer;
    source.connect(gain);
    gain.connect(playCtx.destination);
    source.start(t);
    ignoreUntil = performance.now() + 2500; // el micrófono no analiza el propio tono
    verdict.textContent =
      mode === "guitar" && guitarIndex !== null
        ? `Referencia: cuerda ${strings()[guitarIndex].number} (${noteName(midi)}).`
        : `Referencia: ${noteName(midi)} (${freq.toFixed(1)} Hz).`;
  }

  // ── Hoja de ajustes (bottom sheet) ─────────────────────────────────
  let lastFocus: Element | null = null;
  let dragStartY: number | null = null;
  let dragOffset = 0;

  function openSheet(): void {
    if (sheet.open) return;
    lastFocus = document.activeElement;
    sheet.showModal();
  }

  function closeSheet(): void {
    if (!sheet.open) return;
    sheet.close();
  }

  sheet.addEventListener("close", () => {
    sheet.style.transform = "";
    if (lastFocus instanceof HTMLElement) lastFocus.focus();
    lastFocus = null;
  });
  sheet.addEventListener("click", (event) => {
    if (event.target === sheet) closeSheet();
  });
  sheetBar.addEventListener("pointerdown", (event) => {
    dragStartY = event.clientY;
    sheetBar.setPointerCapture(event.pointerId);
  });
  sheetBar.addEventListener("pointermove", (event) => {
    if (dragStartY === null) return;
    dragOffset = Math.max(0, event.clientY - dragStartY);
    sheet.style.transform = `translateY(${dragOffset}px)`;
  });
  sheetBar.addEventListener("pointerup", () => {
    if (dragOffset > 80) closeSheet();
    dragStartY = null;
    dragOffset = 0;
    sheet.style.transform = "";
  });
  sheetBar.addEventListener("pointercancel", () => {
    dragStartY = null;
    dragOffset = 0;
    sheet.style.transform = "";
  });

  // ── Eventos ────────────────────────────────────────────────────────
  function setMode(next: Mode): void {
    mode = next;
    manual = null;
    targetPc = null;
    lastStringTarget = null;
    lastTargetMidi = null;
    done = new Set();
    tuningField.hidden = mode !== "guitar";
    modeGuitar.setAttribute("aria-pressed", String(mode === "guitar"));
    modeChromatic.setAttribute("aria-pressed", String(mode === "chromatic"));
    autoButton.setAttribute("aria-pressed", "true");
    resetReading(ctx ? playMessage() : waitingMessage());
  }

  startButton.addEventListener("click", () => {
    if (ctx) stop();
    else void start();
  });
  modeGuitar.addEventListener("click", () => setMode("guitar"));
  modeChromatic.addEventListener("click", () => setMode("chromatic"));
  settingsButton.addEventListener("click", openSheet);
  sheetClose.addEventListener("click", closeSheet);
  tuningSelect.addEventListener("change", () => {
    tuningIndex = Number(tuningSelect.value);
    manual = null;
    lastStringTarget = null;
    lastTargetMidi = null;
    done = new Set();
    autoButton.setAttribute("aria-pressed", "true");
    resetReading(ctx ? playMessage() : waitingMessage());
  });
  refPitchSelect.addEventListener("change", () => {
    a4 = Number(refPitchSelect.value) || 440;
    lastStringTarget = null;
    lastTargetMidi = null;
    done = new Set();
    resetReading(ctx ? playMessage() : waitingMessage());
  });
  autoButton.addEventListener("click", () => {
    if (mode === "guitar") {
      manual = null;
      lastStringTarget = null;
    } else {
      targetPc = null;
    }
    lastTargetMidi = null;
    shown = null;
    history = [];
    inTuneSince = 0;
    autoButton.setAttribute("aria-pressed", "true");
    renderStrings();
  });
  stringsEl.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      ".af-str",
    );
    if (!button) return;
    shown = null;
    history = [];
    inTuneSince = 0;
    lastTargetMidi = null;
    if (mode === "guitar") {
      const index = Number(button.dataset.i);
      manual = manual === index ? null : index;
      lastStringTarget = manual;
      autoButton.setAttribute("aria-pressed", String(manual === null));
      renderStrings(manual);
    } else {
      const pc = Number(button.dataset.pc);
      targetPc = targetPc === pc ? null : pc;
      autoButton.setAttribute("aria-pressed", String(targetPc === null));
      renderStrings();
    }
  });
  refButton.addEventListener("click", playReference);
  resetButton.addEventListener("click", () => {
    done = new Set();
    renderStrings(
      mode === "guitar" ? (manual ?? lastStringTarget) : targetPc,
    );
  });
  document.addEventListener("visibilitychange", () => {
    if (document.hidden && ctx) stop();
  });
  window.addEventListener("pagehide", () => {
    if (ctx) stopCapture();
  });

  modeGuitar.setAttribute("aria-pressed", "true");
  modeChromatic.setAttribute("aria-pressed", "false");
  tuningField.hidden = mode !== "guitar";
  renderStrings();
  resetReading(waitingMessage());
</script>

