---
// Tabla interactiva de intervalos: al pulsar una fila se oyen las dos notas
// y se iluminan sobre un teclado y un pentagrama.
---
<section class="box" aria-labelledby="iit-title">
  <h3 id="iit-title">Tabla interactiva de intervalos</h3>
  <p class="mut">Pulsa una fila: oirás las dos notas, verás la distancia en el teclado y su posición en el pentagrama.</p>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:10px 0;">
    <div>
      <p style="font-weight:700;margin:0 0 4px;">Teclado</p>
      <div id="iit-kb" style="position:relative;height:70px;background:var(--bg);border:1px solid var(--bd);border-radius:8px;overflow:hidden;"></div>
    </div>
    <div>
      <p style="font-weight:700;margin:0 0 4px;">Pentagrama</p>
      <svg id="iit-staff" viewBox="0 0 220 90" style="width:100%;max-width:260px;height:auto;color:var(--fg);" role="img" aria-label="Pentagrama con las dos notas"></svg>
    </div>
  </div>
  <p id="iit-info" style="font-weight:700;margin:6px 0;">Pulsa una fila para empezar.</p>

  <div class="scroll" style="margin-top:8px;">
    <table id="iit-table" style="width:100%;border-collapse:collapse;font-size:0.85rem;">
      <thead>
        <tr>
          <th style="text-align:left;padding:4px 6px;border-bottom:1px solid var(--bd);">Sem.</th>
          <th style="text-align:left;padding:4px 6px;border-bottom:1px solid var(--bd);">Intervalo</th>
          <th style="text-align:left;padding:4px 6px;border-bottom:1px solid var(--bd);">Abrev.</th>
          <th style="text-align:left;padding:4px 6px;border-bottom:1px solid var(--bd);">Ejemplo</th>
        </tr>
      </thead>
      <tbody id="iit-body"></tbody>
    </table>
  </div>
</section>

<script>
  import { playNote as pianoNote } from "../lib/piano-engine";
  const NAMES = ["Do","Do♯","Re","Re♯","Mi","Fa","Fa♯","Sol","Sol♯","La","La♯","Si"];
  const ROWS = [
    [0,"Unísono","1.ª justa","Do–Do"],
    [1,"Segunda menor","2.ª m","Do–Re♭"],
    [2,"Segunda mayor","2.ª M","Do–Re"],
    [3,"Tercera menor","3.ª m","Do–Mi♭"],
    [4,"Tercera mayor","3.ª M","Do–Mi"],
    [5,"Cuarta justa","4.ª J","Do–Fa"],
    [6,"Tritono","4.ª A / 5.ª d","Do–Fa♯"],
    [7,"Quinta justa","5.ª J","Do–Sol"],
    [8,"Sexta menor","6.ª m","Do–La♭"],
    [9,"Sexta mayor","6.ª M","Do–La"],
    [10,"Séptima menor","7.ª m","Do–Si♭"],
    [11,"Séptima mayor","7.ª M","Do–Si"],
    [12,"Octava justa","8.ª J","Do–Do"],
  ];
  const tbody = document.getElementById("iit-body") as HTMLElement;
  const info = document.getElementById("iit-info") as HTMLElement;
  const kb = document.getElementById("iit-kb") as HTMLElement;
  const staff = document.getElementById("iit-staff") as SVGElement;

  // Build keyboard (one octave, 13 keys: 8 white + 5 black)
  const whiteIdx = [0,2,4,5,7,9,11];
  const blackIdx = [1,3,6,8,10];
  const keyEls: HTMLElement[] = [];
  whiteIdx.forEach((pc, i) => {
    const el = document.createElement("div");
    el.style.cssText = `position:absolute;bottom:0;left:${(i/8)*100}%;width:${100/8}%;height:100%;background:#fff;border:1px solid #999;border-radius:0 0 4px 4px;box-sizing:border-box;display:flex;align-items:flex-end;justify-content:center;padding-bottom:2px;font-size:0.7rem;color:#333;transition:background 0.25s,transform 0.15s;`;
    el.textContent = NAMES[pc];
    el.dataset.pc = String(pc);
    kb.appendChild(el);
    keyEls.push(el);
  });
  blackIdx.forEach((pc) => {
    const whitesBefore = whiteIdx.filter((w) => w < pc).length;
    const el = document.createElement("div");
    el.style.cssText = `position:absolute;bottom:30%;left:${(whitesBefore/8)*100 - 1.5}%;width:3%;height:70%;background:#222;border-radius:0 0 3px 3px;z-index:2;display:flex;align-items:flex-end;justify-content:center;padding-bottom:2px;font-size:0.6rem;color:#fff;transition:background 0.25s;`;
    el.textContent = NAMES[pc];
    el.dataset.pc = String(pc);
    kb.appendChild(el);
    keyEls.push(el);
  });

  function drawStaff(midiA: number, midiB: number) {
    // 5 lines; higher pitch = higher (smaller y). Do4 (60) sits on first ledger line below staff.
    const lineY = [70, 60, 50, 40, 30]; // bottom to top
    // position in semitones from Do4 (60): y = 70 - (midi-60)*2.5 (approx)
    const yA = 70 - (midiA - 60) * 2.5;
    const yB = 70 - (midiB - 60) * 2.5;
    let svg = "";
    lineY.forEach((y) => { svg += `<line x1="10" y1="${y}" x2="210" y2="${y}" stroke="currentColor" stroke-width="1"/>`; });
    svg += `<text x="14" y="58" font-family="serif" font-size="26" fill="currentColor">𝄞</text>`;
    // note heads
    [[yA, midiA],[yB, midiB]].forEach(([y,m]) => {
      svg += `<ellipse cx="120" cy="${y}" rx="6" ry="4.5" fill="currentColor" transform="rotate(-20 120 ${y})"/>`;
      svg += `<line x1="126" y1="${y}" x2="126" y2="${y-28}" stroke="currentColor" stroke-width="1.2"/>`;
    });
    staff.innerHTML = svg;
  }

  function highlight(pcs: number[]) {
    keyEls.forEach((el) => {
      const pc = parseInt(el.dataset.pc || "0", 10);
      if (pcs.includes(pc)) {
        el.style.background = pc === pcs[0] ? "#4ade80" : "#fbbf24";
        el.style.color = "#000";
        el.style.transform = "scale(1.08)";
      } else {
        el.style.background = el.dataset.pc && blackIdx.includes(parseInt(el.dataset.pc,10)) ? "#222" : "#fff";
        el.style.color = blackIdx.includes(parseInt(el.dataset.pc || "0",10)) ? "#fff" : "#333";
        el.style.transform = "scale(1)";
      }
    });
  }

  ROWS.forEach(([sem, name, abbr, ex]) => {
    const tr = document.createElement("tr");
    tr.style.cursor = "pointer";
    tr.innerHTML = `<td style="padding:4px 6px;">${sem}</td><td style="padding:4px 6px;">${name}</td><td style="padding:4px 6px;">${abbr}</td><td style="padding:4px 6px;">${ex}</td>`;
    tr.addEventListener("click", () => {
      // clear previous highlight
      keyEls.forEach((el) => {
        const pc = parseInt(el.dataset.pc || "0", 10);
        el.style.background = blackIdx.includes(pc) ? "#222" : "#fff";
        el.style.color = blackIdx.includes(pc) ? "#fff" : "#333";
        el.style.transform = "scale(1)";
      });
      const midiA = 60; // Do4
      const midiB = 60 + (sem as number);
      highlight([midiA % 12, midiB % 12]);
      drawStaff(midiA, midiB);
      info.textContent = `${name} · ${sem} semitono${sem === 1 ? "" : "s"} · ${ex}`;
      pianoNote(midiA, 0.8);
      setTimeout(() => pianoNote(midiB, 0.8), 500);
    });
    tr.addEventListener("mouseenter", () => { tr.style.background = "color-mix(in srgb, var(--acc) 12%, transparent)"; });
    tr.addEventListener("mouseleave", () => { tr.style.background = ""; });
    tbody.appendChild(tr);
  });
</script>
